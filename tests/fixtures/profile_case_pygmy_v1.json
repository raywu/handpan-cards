 "_generated_by": "const W = \"/Users/ray/Projects/handpan-cards/.claude/worktrees/agent-a6c6ece55aef5924b\";\nconst fs = require(\"fs\");\nconst { loadEngine } = require(W + \"/tools/engine_loader.js\");\nconst H = loadEngine([\"core\", \"voicing\", \"layout\", \"naming\", \"select\"]);\nH.core.PROFILE_ENABLED = true;\n\nconst GEN = fs.readFileSync(__filename, \"utf8\");\nfunction make(file, seed, mapOf, note) {\n  const p = H.core.parseSeed(seed, {});\n  if (!p.ok) throw new Error(JSON.stringify(p));\n  const map = mapOf(p.value.fields);\n  const q = H.core.parseSeed(seed, { profile: { id: \"paired\", rev: 1, map } });\n  if (!q.ok) throw new Error(JSON.stringify(q));\n  const b = H.select.build(p.value);\n  const s = H.layout.solve(q.value);\n  if (!s.ok) throw new Error(JSON.stringify(s));\n  b.value.geom = s.value.geom;\n  b.value.fields = s.value.fields;\n  fs.writeFileSync(W + \"/tests/fixtures/\" + file, JSON.stringify({\n    _generated_by: GEN, note: note,\n    seed: H.core.formatSeed(q.value), map, deck: b.value }, null, 1) + \"\\n\");\n}\n\nconst PYGMY = \"[C3] [Db3] [Eb3] (F3) G3 Ab3 [Bb3] C4 [Db4] Eb4 F4 G4 Ab4 C5 Eb5 F5 G5 [Ab5]\";\nmake(\"profile_case_pygmy_v1.json\", PYGMY, (f) => H.layout.proposeProfile(f).value,\n  \"Pygmy with HPE.layout.proposeProfile: tops in p1..p9,s1,s2; six bottom notes in s3..s8.\");\n\nconst KURD = \"(D3) A3 Bb3 C4 D4 E4 F4 G4 A4 C5\";\nmake(\"profile_case_kurd9_v1.json\", KURD, (f) => {\n  const keys = Object.values(f).filter((v) => v[3] === \"rim\").map((v) => \"r\" + v[2]);\n  const slots = [0, 1, 2, 4, 5, 6, 8, 12, 16];\n  const map = new Array(18).fill(null);\n  keys.forEach((k, i) => { map[slots[i]] = k; });\n  return map;\n}, \"Nine rim notes in p1,p2,p3,p5,p6,p7,p9,s4,s8: p4 and p8 stay empty.\");\n",

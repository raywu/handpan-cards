# kills: card swipe: a short mouse drag whose lostpointercapture carries a stale clientX still springs back
# suite: node --test --test-name-pattern ^card.swipe..a.short.mouse.drag.whose.lostpointercapture.carries.a.stale.clientX.still.springs.back$ tests/e2e.test.js
# Always pushes the lostpointercapture event's own point into drag.pts
# (pushPoint forced true), reintroducing the bug where a stale/unrelated
# lpc coordinate can corrupt the trailing-window velocity into a
# spurious fling and commit a short, slow drag that should spring back.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8219,7 +8219,7 @@ card.addEventListener("pointercancel", e => { if (drag && e.pointerId === drag.i
 // not pushed into drag.pts on this path (see release()'s pushPoint doc).
 card.addEventListener("lostpointercapture", e => {
   if (!drag || e.pointerId !== drag.id) return;
-  if (e.pointerType === "mouse" && !(e.buttons & 1)) release(e, false, false);
+  if (e.pointerType === "mouse" && !(e.buttons & 1)) release(e, false, true);
   else release(e, true);
 });

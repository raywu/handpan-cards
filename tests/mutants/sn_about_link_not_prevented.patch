# kills: AO: a click on a deck link inside About is default-prevented and goes through aboutLink
# suite: node --test --test-name-pattern ^AO:.a.click.on.a.deck.link.inside.About tests/app.test.js
# The About click handler stops calling preventDefault, so the browser navigates as well.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -11785,7 +11785,6 @@ function aboutLink(href) {
 aboutSection.addEventListener("click", e => {
   const a = e.target && e.target.closest ? e.target.closest('a[href^="#deck="]') : null;
   if (!a) return;
-  e.preventDefault();
   aboutLink(a.getAttribute("href"));
 });
 

# kills: retyping a seed with a different field count drops the correction and the mock follows
# suite: node --test --test-name-pattern ^retyping.a.seed.with.a.different.field.count.drops.the.correction.and.the.mock.follows$ tests/app.test.js
# The length guard is gone, so a stale ring list is handed to a seed whose
# ring has a different note count. HPE.layout.solve refuses the pan,
# paintPan returns false, and holdPanPreview keeps the previous pan - the
# Edit mock stops following what is being typed.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8811,7 +8811,7 @@ function syncLayoutSeats(fields) {
   if (layoutSeats) {
     const kept = {};
     for (const ring of LAYOUT_RINGS) {
-      if (layoutSeats[ring] && layoutSeats[ring].length === sizes[ring]) kept[ring] = layoutSeats[ring];
+      if (layoutSeats[ring] && true) kept[ring] = layoutSeats[ring];
     }
     layoutSeats = Object.keys(kept).length ? kept : null;
   }

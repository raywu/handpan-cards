# kills: LF: the root rule sets text-size-adjust to 100% with the -webkit- prefix, so landscape iOS does not inflate text
# suite: node --test --test-name-pattern ^LF..the.root.rule.sets.text.size.adjust.to.100..with.the..webkit..prefix..so.landscape.iOS.does.not.inflate.text$ tests/app.test.js
# Drops the text-size-adjust declarations from the html root rule, so iOS Safari
# in landscape inflates text again.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -114,7 +114,6 @@ gtag("js", new Date());
      landscape - ever picks it up and spends the chrome budget on it. */
   --sp-1:4px; --sp-2:8px; --sp-3:14px; --sp-4:22px;
 }
-html{-webkit-text-size-adjust:100%; text-size-adjust:100%}
 @media (min-width:640px) and (min-height:700px){
   :root{--sp-1:6px; --sp-2:12px; --sp-3:20px; --sp-4:28px}
 }

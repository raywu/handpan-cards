+#editor-hint-toggle{position:absolute; z-index:1; box-sizing:border-box; width:44px; height:44px; min-width:44px; min-height:44px; padding:0; margin:0;
   display:flex; align-items:center; justify-content:center; background:none; border-color:transparent; box-shadow:none; color:#5E5A53}
 #editor-hint-toggle[hidden]{display:none}

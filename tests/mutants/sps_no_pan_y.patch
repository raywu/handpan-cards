# kills: FT: a horizontal drag steps the chord, a slow 30px drag included
# suite: node --test --test-name-pattern ^FT:.a.horizontal.drag.steps.the.chord,.a.slow.30px.drag.included$ tests/e2e.test.js
# The injected touch-action:pan-y rule is dropped, so the browser may take a horizontal touch drag as a page pan.
diff --git a/scales/d-kurd-9/index.html b/scales/d-kurd-9/index.html
--- a/scales/d-kurd-9/index.html
+++ b/scales/d-kurd-9/index.html
@@ -50,7 +50,7 @@
 .prog>input:has(+input:checked){left:calc((100% - min(322px,100%))/2);pointer-events:auto}
 .prog .nav label{pointer-events:none}
 .prog .cards{width:min(322px,100%)}
-.prog.sw .cards{touch-action:pan-y;-webkit-user-select:none;user-select:none}
+.prog.sw .cards{-webkit-user-select:none;user-select:none}
 .rail{margin-top:4px;max-width:100%;overflow:hidden;white-space:nowrap;font:20px/1.3 Marcellus,serif;letter-spacing:.02em;color:var(--muted)}
 .rail b{font-weight:400;color:var(--fg);text-decoration:underline var(--r);text-underline-offset:3px}
 .prog .slot{display:none;gap:10px}

# kills: the card's small print meets AA contrast against the paper
# suite: node --test --test-name-pattern ^the.card.s.small.print.meets.AA.contrast.against.the.paper$ tests/e2e.test.js
# Reverts the two LOWER-priority greys of row 215 only, leaving .hint correct.
# Without this the hint mutant alone would prove the test live while the
# .hdr .l .num (3.45:1 at 9px) and .sepc (2.95:1) probes could be dead code.
diff --git a/index.html b/index.html
index 574a311..cf60bf1 100644
--- a/index.html
+++ b/index.html
@@ -221,7 +221,7 @@ main{flex:1; display:flex; align-items:center; justify-content:center; width:100
    grey is ground truth. Note the consequence: --sep now has NO consumer at
    all, in CSS or in JS. It is a dead token, left in place only because
    removing it is a restyle beyond these three rows. */
-.hdr .l .num{color:#757575; font-weight:400}
+.hdr .l .num{color:var(--sep); font-weight:400}
 .hdr .l .deg{color:var(--root); font-weight:600; letter-spacing:.06em}
 .hdr .r{font:600 8px/1.3 "Nunito Sans"; letter-spacing:.11em; color:var(--ink);
   text-align:right; max-width:55%; text-transform:uppercase}
@@ -250,7 +250,7 @@ main{flex:1; display:flex; align-items:center; justify-content:center; width:100
 /* The note/number-line separators: #9a949f was 2.95:1 on the paper. #75707c
    keeps the same cool cast at 4.81:1 and stays clearly recessive against the
    root/tone colours it sits between. */
-.sepc{color:#75707c}
+.sepc{color:#9a949f}
 footer{width:100%; max-width:520px; display:flex; align-items:center;
   justify-content:space-between; gap:var(--sp-2); margin-top:var(--sp-3)}
 button.nav{flex:0 0 auto; width:56px; height:44px; border-radius:10px; border:1px solid #433b2c;

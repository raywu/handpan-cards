# kills: card swipe (wheel): momentum wheel events after a committed gesture lands do not step again
# suite: node --test --test-name-pattern ^card.swipe..wheel...momentum.wheel.events.after.a.committed.gesture.lands.do.not.step.again$ tests/e2e.test.js
# Drops `flight` from the wheel gesture's skip condition: trackpad
# momentum events arriving while the previous gesture's card is still
# flying out can start a brand new gesture and commit a second step.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -9308,7 +9308,7 @@ if (wheelMain) wheelMain.addEventListener("wheel", e => {
     // is open is skipped for its whole duration (the flag persists until
     // the 160ms gap, not just for this event), so wheel momentum arriving
     // right after a flight lands cannot start a fresh gesture and double-step.
-    const skip = !!(flight || drag || panelOpen || sheetOpen || !order.length);
+    const skip = !!(drag || panelOpen || sheetOpen || !order.length);
     wheel = { sx: 0, axis: null, fired: false, skip, timer: null };
   }
   if (wheel.timer) clearTimeout(wheel.timer);

# kills: card swipe (wheel): momentum wheel events after a committed gesture lands do not step again
# suite: node --test --test-name-pattern ^card.swipe..wheel...momentum.wheel.events.after.a.committed.gesture.lands.do.not.step.again$ tests/e2e.test.js
# Drops `flight` from the wheel gesture's skip condition: trackpad
# momentum events arriving while the previous gesture's card is still
# flying out can start a brand new gesture and commit a second step.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -15267,7 +15267,7 @@ if (wheelMain) wheelMain.addEventListener("wheel", e => {
   wheel.axis = d.axis;
   if (d.kind === "skip" || d.kind === "pass") return; // vertical-dominant: never claimed, never preventDefault-ed
   e.preventDefault();
-  if (d.kind === "hold" || flight) return;
+  if (d.kind === "hold") return;
   wheel.sx = d.sx;
   if (d.kind === "commit") {
     wheel.fired = true;

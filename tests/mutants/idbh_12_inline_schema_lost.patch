# fault: Report an inline store as out-of-line rather than preserving keyPath metadata.
diff --git a/tools/sandbox.js b/tools/sandbox.js
--- a/tools/sandbox.js
+++ b/tools/sandbox.js
@@ -286,7 +286,7 @@ function indexedDBFor(bucket) {
       if (!tx || tx._done) throw idbError('InvalidStateError');

# kills: AP2-1 sheet open leaves the expected state per mode
# suite: node --test --test-name-pattern ^AP2-1.sheet.open.leaves.the.expected.state.per.mode$ tests/app.test.js
# resetSheetState forgets layoutSel, so the selected pan slot of a previous
# session leaks into the next open.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -9316,7 +9316,6 @@ function resetSheetState(edit) {
   // The correction is a seed option like the others, so Edit shows the one the
   // deck already carries and RESET is what clears it.
   layoutSeats = edit && edit.options.seats ? JSON.parse(JSON.stringify(edit.options.seats)) : null;
-  layoutSel = 0;
   anchor = edit && edit.options.anchor === "between" ? "between" : "one";
   mirrorBottom = edit && typeof edit.options.mirrorBottom === "boolean" &&
     edit.options.mirrorBottom !== !!edit.options.mirror ? edit.options.mirrorBottom : null;

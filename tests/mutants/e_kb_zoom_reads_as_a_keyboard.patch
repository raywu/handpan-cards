# kills: a zoom with the keyboard up is left alone at every pan position
# suite: node --test --test-name-pattern ^a.zoom.with.the.keyboard.up.is.left.alone.at.every.pan.position$ tests/e2e.test.js
# The zoom gate goes away, so a pinch-zoom is measured as a keyboard again
# (queue row 87). vv.height shrinks under zoom exactly as it does under a
# keyboard, so the sheet lifts and caps itself for a reader who was only
# zooming in.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -12635,8 +12635,8 @@ function applyKbOffset(e) {
    * deliberate fingers, and the reader who zoomed can pan.
    * The tolerance is for scales that do not land exactly on 1 coming back from
    * a pinch; a sub-percent residue is not a zoom. */
-  const zoomed = sheetZoomed();
-  if (zoomed) sheetSwipe = null;
+  const zoomed = false;
+  if (sheetZoomed()) sheetSwipe = null;
   /* The keyboard-free baseline is the sheet's own height, not innerHeight:
    * #scale-sheet is position:fixed; inset:0, so it is the layout viewport's
    * height and does not depend on the cap or translate written below. iOS can

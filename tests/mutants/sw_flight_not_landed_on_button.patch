# kills: card swipe: buttons and arrows during the fly-out land it first, never dropping or doubling a step
# buttons and arrows during the fly-out land it first, never dropping or doubling a step
# suite: node --test --test-name-pattern ^card.swipe:.buttons.and.arrows.during.the.fly-out.land.it.first,.never.dropping.or.doubling.a.step$ tests/e2e.test.js
# Drops land() from the capture-phase click listener. Per OV1, a real mouse
# click on #next/#prev during a fly-out is already landed by the earlier
# capture-phase pointerdown listener before the click ever fires, so only
# E9's third leg - a programmatic .click() (no pointerdown of its own) -
# depends on this listener's own land() call, and only that leg fails.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8134,7 +8134,6 @@ document.addEventListener("pointerdown", e => {
 }, true);
 document.addEventListener("keydown", () => { land(); }, true);
 document.addEventListener("click", e => {
-  land();
   if (eatClick) { eatClick = false; e.stopPropagation(); e.preventDefault(); }
 }, true);
 

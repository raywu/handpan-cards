# Drops land() from the capture-phase click listener. Per OV1, a real mouse
# click on #next/#prev during a fly-out is already landed by the earlier
# capture-phase pointerdown listener before the click ever fires, so only
# E9's third leg - a programmatic .click() (no pointerdown of its own) -
# depends on this listener's own land() call, and only that leg fails.
# Context-refreshed 2026-09-30 (desktop-swipe lane): hunk context updated for release()/lpc/wheel refactor (setEatClick, flyOut/springBack, pushPoint); the mutation itself is unchanged.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8445,7 +8445,6 @@ document.addEventListener("click", e => {
   // its release speed. A click that didn't come from a drag (eatClick
   // false) still lands a live flight, same as before.
   if (eatClick) { setEatClick(false); e.stopPropagation(); e.preventDefault(); return; }
-  land();
 }, true);
 

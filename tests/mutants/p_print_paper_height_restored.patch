# PRINT_PAPER.h was the only source of the page-box literal. Keeping the key
# invites the next edit to read it again; the deletion is the guard.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -4187,7 +4187,7 @@ const PRINT_SAFE = { margin: 45 };

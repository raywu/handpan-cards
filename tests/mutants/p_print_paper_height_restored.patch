    across two physical pages. Only the size keyword survives. */
-const PRINT_PAPER = { letter: { css: "letter" }, a4: { css: "A4" } };
+const PRINT_PAPER = { letter: { css: "letter", h: 792 }, a4: { css: "A4", h: 841.89 } };
 
 /** True for every iOS/iPadOS Safari, which ignores the `@page` at-rule
  *  outright - size, orientation and `margin:0` alike - and enforces a page

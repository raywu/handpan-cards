# kills: Resources links activate on click and on Enter, to the right href, without closing the panel or changing mode/card
# suite: node --test --test-name-pattern Resources.links.activate.on.click.and.on.Enter tests/e2e.test.js
# Eng review amendment 7 (Codex finding, docs/plans/2026-10-01-resources-menu.md):
# the original behaviour test only proved nothing broke when a click was
# intercepted and defaultPrevented - true of literally any link, even a dead
# one. This mutant makes HANDPANER dead to the keyboard specifically: an
# onkeydown handler calls preventDefault() on Enter, which suppresses the
# browser's synthetic click-from-Enter entirely. A mouse click on the link
# still works (pointer-events and the click handler are untouched), and
# every other control's Tab/Enter behaviour is unaffected, so only the real
# keyboard-activation assertion this amendment exists to add can see it.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -1323,7 +1323,7 @@ footer.seq{row-gap:var(--sp-1)}
          boxes) the two Amy Naylor videos. -->
     <div class="modebar">
       <a class="mode" id="res-handpaner" href="https://handpaner.com/"
-         target="_blank" rel="noopener">HANDPANER</a>
+         target="_blank" rel="noopener" onkeydown="if(event.key==='Enter')event.preventDefault()">HANDPANER</a>
       <a class="mode" id="res-dingandtones" href="https://www.dingandtones.com/"
          target="_blank" rel="noopener">DING &amp; TONES</a>
       <a class="mode" id="res-trainingcards" href="https://svenkirchhofer.de/handpan-training-cards/"

# kills: the LAYOUT hint is visible inside the group, not merely present in the file
# suite: node --test --test-name-pattern ^the.LAYOUT.hint.is.visible.inside.the.group..not.merely.present.in.the.file$ tests/e2e.test.js
# The hint is hoisted out of #scale-layout-row and sits above it. It renders,
# it reads correctly - and it now explains a group of buttons it is no longer
# part of, so it is visible when the LAYOUT row is HIDDEN and it no longer
# travels with the controls it describes. Text-matching cannot see placement.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -1229,6 +1229,7 @@

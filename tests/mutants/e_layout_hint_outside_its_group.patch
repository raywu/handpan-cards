         <div class="editrow" id="scale-legacy-group" role="group" aria-labelledby="scale-layout-label"
              aria-describedby="scale-legacy-hint" hidden>
           <span class="sheetlabel" id="scale-layout-label">LAYOUT</span>
@@ -1240,7 +1241,6 @@

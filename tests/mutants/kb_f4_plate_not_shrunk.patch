# kills: KB: F4 with the drawer open at 390x669 the per-viewport floor of options shows under the pan (160px where the viewport allows) and the plate is at least 140px
# suite: node --test --test-name-pattern ^KB..F4.with.the.drawer.open.at.390x669.the.per.viewport.floor.* tests/e2e.test.js
# The open-drawer plate goes back to the 39dvh cap, so fewer than 160px of options show under the pan.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -1053,7 +1053,7 @@
 .scalestage > #scale-plate-band{position:sticky; top:0; z-index:2; background:#1f1b15;
   padding-bottom:var(--sp-1)}
 .scalestage #scale-preview{width:clamp(110px, calc(100cqh - 260px), 300px); max-width:none}
-.sheetbody:has(#scale-layout-zone.open) #scale-preview{width:100%; max-width:min(300px, 31dvh)}
+.sheetbody:has(#scale-layout-zone.open) #scale-preview{width:100%; max-width:min(300px, 39dvh)}
 .sheetbody:has(#scale-layout-zone.open):has(input:focus, textarea:focus, #scale-swatches button:focus)
   #scale-plate-band{position:static}
 .sheetbody:has(#scale-layout-zone.nostick) #scale-plate-band{position:static}

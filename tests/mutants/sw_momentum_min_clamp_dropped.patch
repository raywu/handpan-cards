# kills: swipeOutTiming: a fast flick clamps at SWIPE_MOMENTUM_MIN_MS and still starts at its release speed
# swipeOutTiming: a fast flick clamps at SWIPE_MOMENTUM_MIN_MS and still starts at its release speed
# suite: node --test --test-name-pattern ^swipeOutTiming:.a.fast.flick.clamps.at.SWIPE_MOMENTUM_MIN_MS.and.still.starts.at.its.release.speed$ tests/app.test.js
# Drops the Math.max(SWIPE_MOMENTUM_MIN_MS, ...) clamp from swipeOutTiming's
# duration calculation (docs/plans/2026-10-01-swipe-momentum.md, decision 2).
# A fast flick's raw d/v then goes unclamped - 60ms for the test's fixture,
# not the floored 140ms - so the card can snap off in less than the plan's
# minimum fly-out time.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8178,7 +8178,7 @@ function swipeOutTiming(vx, dir, dx, dist) {
   const v = Math.max(-dir * vx, SWIPE_MOMENTUM_FLOOR_PX_MS);
   const end = Math.max(dist, Math.abs(dx) + SWIPE_MOMENTUM_FLOOR_PX_MS * SWIPE_MOMENTUM_MIN_MS);
   const d = end - Math.abs(dx);
-  const duration = Math.min(SWIPE_MOMENTUM_MAX_MS, Math.max(SWIPE_MOMENTUM_MIN_MS, d / v));
+  const duration = Math.min(SWIPE_MOMENTUM_MAX_MS, d / v);
   const k = v * duration / d;
   const x1 = Math.min(1 / 3, 1 / k);
   const y1 = k * x1;

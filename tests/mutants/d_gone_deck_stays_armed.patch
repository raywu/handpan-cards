# kills: deleting an instance that disappeared leaves no armed button and preserves explicit conflict recovery
# suite: node --test --test-name-pattern=^deleting.an.instance.that.disappeared.leaves.no.armed.button.and.preserves.explicit.conflict.recovery$ tests/app.test.js
# former kills: deleting a deck that is already gone leaves no armed button behind
# fault: A confirming delete leaves its old arming state behind when the instance already disappeared.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -13637,7 +13637,7 @@ delBtn.onclick = () => {
   /* Disarm BEFORE the delete, not inside it: the state must not outlive the
      deck even when deleteDeck turns out to have nothing to remove, and the
      delete's own message should be the last thing said. */
-  if (delArmed) { disarmDelete(); deleteDeck(target); return; }
+  if (delArmed) { deleteDeck(target); return; }
   delArmed = true;
   delBtn.textContent = DEL_ARMED();
   delBtn.setAttribute("data-armed", "");

# kills: a tap selects the note that was tapped, on a pan that is already corrected
# suite: node --test --test-name-pattern ^a.tap.selects.the.note.that.was.tapped..on.a.pan.that.is.already.corrected$ tests/app.test.js
# Setting layoutSel to the field index instead of looking it up through the
# ring's seats selects the right note only on an uncorrected pan.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8843,7 +8843,7 @@ function selectPanField(id) {
   const i = layoutIds(fields).indexOf(String(id));
   if (i < 0) return false;
   const [a, b] = zoneBlock(fields, i);
-  layoutSel = a + seatsFor(slotZones(fields)[i], b - a)[i - a];
+  layoutSel = i;
   previewLayout();
   return true;
 }

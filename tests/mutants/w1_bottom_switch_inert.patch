diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -12856,7 +12856,7 @@ mirrorTop.onclick = () => {
   layoutStatus(t(mirror ? "sheet.mirror_top_on" : "sheet.mirror_top_off"));

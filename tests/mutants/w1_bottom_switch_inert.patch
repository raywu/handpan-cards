 mirrorBot.onclick = () => {
-  bottomHeld = !bottomHeld;
+  bottomHeld = bottomHeld;
   if (!toggleFits()) { bottomHeld = !bottomHeld; layoutStatus(TOGGLE_REFUSED()); return; }
   paintLayout(); resyncSheet(true);
   layoutStatus(t(bottomMirror() ? "sheet.mirror_bottom_on" : "sheet.mirror_bottom_off"));

# kills: card swipe (wheel): a sub-threshold gesture's spring-back starts exactly where the follow transform left off
# suite: node --test --test-name-pattern ^card.swipe..wheel...a.sub.threshold.gesture.s.spring.back.starts.exactly.where.the.follow.transform.left.off$ tests/e2e.test.js
# Restores the F3 bug: springBack(w.sx) instead of springBack(-w.sx). The
# live follow transform during the gesture is swipeXf(-w.sx), so the
# spring-back's first keyframe (swipeXf(dx)) ends up mirrored - opposite
# translateX and rotate - from where the card actually was, producing a
# visible jump-to-mirror glitch on any sub-threshold trackpad swipe.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8248,7 +8248,7 @@ function wheelGestureEnd() {
   // listener below); springBack's own first keyframe is swipeXf(dx), so it
   // must take -w.sx too, or the spring-back starts mirrored (opposite
   // translateX and rotate) from where the card actually was.
-  springBack(-w.sx);
+  springBack(w.sx);
 }
 if (wheelMain) wheelMain.addEventListener("wheel", e => {
   if (e.ctrlKey) return; // pinch-zoom, not a swipe gesture

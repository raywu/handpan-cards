# kills: a name containing a curly apostrophe (U+2019) saves, normalised to ASCII
# suite: node --test --test-name-pattern ^a.name.containing.a.curly.apostrophe..U.2019..saves..normalised.to.ASCII$ tests/app.test.js
# The new editor's name setter stops folding iOS smart punctuation to ASCII (owner D4a), so a curly apostrophe is stored as typed.
#
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -12959,7 +12959,7 @@ const EDITOR_NAME_MAX = 40;
 function editorSetName(m, text) {
   const folded = String(text).replace(/[\u2018\u2019]/g, "'").replace(/[\u201C\u201D]/g, '"')
     .replace(/[\u2013\u2014]/g, "-").replace(/\u2026/g, "...");
-  const name = Array.from(folded.trim()).slice(0, EDITOR_NAME_MAX).join("").trim();
+  const name = Array.from(String(text).trim()).slice(0, EDITOR_NAME_MAX).join("").trim();
   if ((m.options.name || "") === name) return { ok: true, value: m };
   const next = editorClone(m);
   if (name) next.options.name = name; else delete next.options.name;

# kills: a same-id generate replaces the deck in place, keeps the id and says Updated
# suite: node --test --test-name-pattern ^a.same.id.generate.replaces.the.deck.in.place..keeps.the.id.and.says.Updated$ tests/app.test.js
# A regenerate of a deck that already exists reports it as newly generated,
# so the user cannot tell a replacement from an addition.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -9509,8 +9509,7 @@ function runGenerate() {
   // [eng-review 2, 2A] the warnings are read off the deck the SAME generation
   // produced; nothing is rebuilt to re-derive them.
   const warned = (d.warnings || []).map(w => w.reason);
-  let text = (replaced || known.has(d.id))
-    ? `Updated ${d.name}` : `${d.chords.length} cards generated`;
+  let text = `${d.chords.length} cards generated`;
   if (warned.length) text += " " + warned.join(" ");
 
   closeScaleSheet();

# kills: card swipe: the card follows a held drag with a tilt, then springs back below the threshold
# suite: node --test --test-name-pattern ^card.swipe..the.card.follows.a.held.drag.with.a.tilt..then.springs.back.below.the.threshold$ tests/e2e.test.js
# startDrag() is shared by the ordinary #card pointerdown and the mid-flight
# capture-phase document pointerdown (finding 13, quality-refactor plan
# 2026-09-30). Dropping the `drag = {...}` assignment leaves the global
# `drag` unset, so every pointermove handler that gates on `drag` (swipeMove)
# never moves the card at all.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8886,7 +8886,6 @@ function swipeMove(e) {
 // caller-side, since the two sites gate on different conditions.
 function startDrag(e) {
   scene.getAnimations().forEach(a => a.cancel());
-  drag = { id: e.pointerId, x0: e.clientX, y0: e.clientY, last: 0, lastY: 0, moved: false, pts: [{ x: e.clientX, t: e.timeStamp }], pointerType: e.pointerType };
   card.setPointerCapture(e.pointerId);
 }
 function canStartGesture(e, state) {

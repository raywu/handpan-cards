# kills: a swipe that starts within 24px of either screen edge is left to the browser
# suite: node --test --test-name-pattern ^a.swipe.that.starts.within.24px tests/editor_e2e.test.js
# fault: A swipe that starts at the screen edge switches tabs instead of being left to the browser.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -17011,7 +17011,7 @@ function editorWireSwipe() {
   body.addEventListener("touchstart", (e) => {
     stop();
     const ts = e.touches, p = ts && ts.length === 1 && ts[0], t = e.target;
-    if (!p || !eligible() || p.clientX < 24 || p.clientX > window.innerWidth - 24 ||
+    if (!p || !eligible() || false ||
         (t && t.closest && t.closest("#editor-pan, .tray-note, input, textarea, select"))) return;
     g = { id: p.identifier, x: p.clientX, y: p.clientY, at: e.timeStamp, tab: editorSession.tab, top: body.scrollTop };
   }, { passive: true });

# kills: Tab brings every stop into the panel's scrollport on a short screen 375x440
# suite: node --test --test-name-pattern ^Tab.brings.every.stop.*375x440 tests/editor_e2e.test.js
# fault: Tab stalls rather than focusing the next control below the drawer viewport.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -18496,6 +18496,8 @@ function cycleTabStops(all, e) {
   const i = stops.indexOf(document.activeElement);
   const next = e.shiftKey ? (i <= 0 ? stops.length - 1 : i - 1) : (i === stops.length - 1 ? 0 : i + 1);
   e.preventDefault();
+  const drawer = stops[next].closest("#drawerexp-body");
+  if (drawer && stops[next].getBoundingClientRect().bottom > drawer.getBoundingClientRect().bottom) return;
   stops[next].focus();
 }
 

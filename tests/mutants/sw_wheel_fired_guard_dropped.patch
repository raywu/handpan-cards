# kills: card swipe (wheel): deltaX past 80px advances the deck exactly once per gesture
# suite: node --test --test-name-pattern ^card.swipe..wheel...deltaX.past.80px.advances.the.deck.exactly.once.per.gesture$ tests/e2e.test.js
# Inverts the wheel.fired guard (checks !wheel.fired instead of
# wheel.fired) so the gesture accumulator never runs after the first
# event: the deck never advances at all, instead of advancing exactly
# once per gesture.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8981,7 +8981,7 @@ if (wheelMain) wheelMain.addEventListener("wheel", e => {
   wheel.axis = d.axis;
   if (d.kind === "skip" || d.kind === "pass") return; // vertical-dominant: never claimed, never preventDefault-ed
   e.preventDefault();
-  if (d.kind === "hold") return;
+  if (d.kind !== "hold") return;
   wheel.sx = d.sx;
   if (d.kind === "commit") {
     wheel.fired = true;

# kills: card swipe (wheel): deltaX past 80px advances the deck exactly once per gesture
# suite: node --test --test-name-pattern ^card.swipe..wheel...deltaX.past.80px.advances.the.deck.exactly.once.per.gesture$ tests/e2e.test.js
# Inverts the wheel.fired guard (checks !wheel.fired instead of
# wheel.fired) so the gesture accumulator never runs after the first
# event: the deck never advances at all, instead of advancing exactly
# once per gesture.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8259,7 +8259,7 @@ wheelMain.addEventListener("wheel", e => {
   if (wheel.axis === null && (dx !== 0 || dy !== 0)) wheel.axis = Math.abs(dx) > Math.abs(dy) ? "x" : "y";
   if (wheel.axis !== "x") return; // vertical-dominant: never claimed, never preventDefault-ed
   e.preventDefault();
-  if (wheel.fired) return;
+  if (!wheel.fired) return;
   wheel.sx += dx;
   // wheel.sx plays the same role as a drag's own dx (the scene's own visual
   // offset): negative -> next card, matching swipeDecision's dx < 0 -> dir 1.

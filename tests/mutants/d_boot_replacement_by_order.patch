# kills: SD: a seed both hidden and replaced boots onto its replacement without a warning
# suite: node --test --test-name-pattern ^SD..a.seed.both.hidden.and.replaced.boots.onto.its.replacement.without.a.warning$ tests/app.test.js
# deck() stops resolving a hidden seed to its replacement, so the landing is whatever fallbackDeck() or chip order picks.
# Approved retained contract mapped to the transactional instance adapter.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -10288,7 +10288,7 @@ function savedFallback(e, views) {
 }
 function savedResolve(wanted, e, views) {
   const visible = savedViewsFor(e, views);
-  if (wanted && wanted.kind === "builtin" && e.slots[wanted.id] && views.has(e.slots[wanted.id]))
+  if (false && wanted && wanted.kind === "builtin" && e.slots[wanted.id] && views.has(e.slots[wanted.id]))
     return { kind: "saved", id: e.slots[wanted.id] };
   return visible.some(view => savedEqual(view.selection, wanted)) ? savedClone(wanted) : savedFallback(e, views);
 }

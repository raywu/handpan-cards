# kills: card swipe: a second real swipe from the REST position during flight is not dropped
# suite: node --test --test-name-pattern ^card.swipe:.a.second.real.swipe.from.the.REST.position.during.flight.is.not.dropped$ tests/e2e.test.js
# Q12: drops `main{touch-action:none}`, leaving `main` free to start its own
# native horizontal pan/scroll gesture under a real touch drag that starts
# over it (the REST position, mid-flight, hit-tests to `main` - see the
# comment above the pointerdown listener). `.scene`'s own rule alone no
# longer suffices once the ancestor has none.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -429,7 +429,6 @@ main{flex:1; display:flex; align-items:center; justify-content:center; width:100
    accumulated vertical drift crossed ~10-11.7px, well under the ~6.3px seen
    on swipes that committed cleanly. A touch on the card must never scroll or
    zoom the page, so both main and .scene drop to touch-action:none - main
    for the same mid-flight-hit-test reason as above. */
-main{touch-action:none}
 .scene{touch-action:none}
 main{overflow-x:clip}
 /* The card is sized from whichever axis runs out first.

# The preview solves with MIRROR BOTTOM off, so the switch does nothing to the drawn pan.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -13853,7 +13853,7 @@ function solvePreviewLayout(seed) {
     const solved = solveNeotonePreview(seed);
     if (solved) return solved;
   }
-  const solveOptions = { mirror: mirror, mirrorBottom: bottomMirror(), anchor: anchor,
+  const solveOptions = { mirror: mirror, mirrorBottom: false, anchor: anchor,
     seats: fitSeats(seed.fields), angles: fitAngles(seed.fields) };
   const res = HPE.layout.solve(seed, solveOptions);
   return res.ok ? res.value : null;

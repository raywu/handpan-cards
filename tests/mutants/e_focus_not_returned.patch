# kills: Escape closes the sheet and focus returns to + ADD
# Closing the sheet drops focus on the body instead of returning it to the
# chip that opened it, so a keyboard user restarts from the top of the page.
diff --git a/index.html b/index.html
index a127d86..f0f838c 100644
--- a/index.html
+++ b/index.html
@@ -2903,7 +2903,6 @@ function closeScaleSheet() {
   sheetOpen = false;
   editingId = null;
   for (const el of background) { el.inert = false; el.removeAttribute("aria-hidden"); }
-  (sheetOpener || addChip).focus();
   sheetOpener = null;
 }
 

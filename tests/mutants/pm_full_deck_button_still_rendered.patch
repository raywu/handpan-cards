# kills: PM rule 1: the print row is DOWNLOAD PDF then the paper select, and no full-deck control is rendered
# suite: node --test --test-name-pattern PM.rule.1 tests/app.test.js
# Lane PM. Puts a FULL DECK PDF button back at the head of the print row, so the panel again offers a
# full-deck control the plan removed.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -1382,6 +1382,7 @@ footer.seq{row-gap:var(--sp-1)}
   <div class="panel-group">
     <h3 class="panel-heading">Print this deck</h3>
     <div class="prints">
+      <button type="button" onclick="downloadDeckPDF('full', this); closePanel();">FULL DECK PDF</button>
       <button type="button" id="print-download" onclick="downloadDeckPDF('shop', this); closePanel();">DOWNLOAD PDF</button>
       <!-- The paper choice keeps the panel open (design direction, "After an
            action"): the next tap is a print button, not a new task. -->

# kills: a pan warning on the Edit open does not move the pan
# suite: node --test --test-name-pattern ^a.pan.warning.on.the.Edit.open.does.not.move.the.pan$ tests/e2e.test.js
# openEditSheet()'s pan warning is routed into the SEED's reserved row. This is
# the first half of the reviewer's FAIL, 2026-09-21, reproduced exactly: the
# warning fires after showSheet() has already filled the parse line, so the row
# carries two lines instead of one, the pan steps 26.59px down under the
# finger and #scale-layout-row's bottom reaches 785.69 against a 780px
# viewport - below the fold, the cost the move exists to avoid. Nothing about
# the warning's text or tier changes, which is why only a geometric test sees
# it. The rule this mutates is the split itself: #scale-refusal carries SEED
# REFUSALS ONLY, and say() never writes into the .fieldrow.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -4922,7 +4922,7 @@ function openEditSheet(d, opener) {
   // [eng-review 2, 2A] warnings have ONE producer and were copied onto the deck
   // at generation time; the Edit sheet reads them and never rebuilds to re-derive.
   const warned = (d.warnings || []).map(w => w.reason);
-  if (warned.length) say(warned.join(" "), "warn");
+  if (warned.length) showRefusal(warned.join(" "));
 }
 /** Take the page down. The DOM half only - the route is the caller's. */
 function hideSheet() {

# kills: P0 tabs: a tap near the Layout tab's right edge lands on the tab (the info button sits in the name row, not the strip)
# suite: node --test --test-name-pattern ^P0.tabs:.a.tap.near.the.Layout tests/editor_e2e.test.js
# fault: editorRenderTabs appends the info button to the tab strip instead of the name row, so it covers the Layout tab's right edge.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -14032,7 +14032,7 @@ function editorRenderTabs() {
   const tog = editorEl("editor-hint-toggle"), row = editorEl("editor-panel-" + s.tab).querySelector(".editor-hintrow");
   if (tog && row && tog.parentNode !== row) {
     const had = document.activeElement === tog;
-    row.appendChild(tog);
+    editorEl("editor-tabs").appendChild(tog);
     if (had) tog.focus();
   }
 }

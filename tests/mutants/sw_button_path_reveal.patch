# kills: card swipe: #next and ArrowRight on a flipped card deal without a reverse-flip transition
# #next and ArrowRight on a flipped card deal without a reverse-flip transition
# suite: node --test --test-name-pattern ^card.swipe:.#next.and.ArrowRight.on.a.flipped.card.deal.without.a.reverse-flip.transition$ tests/e2e.test.js
# N40: drops step()'s transition:none/forced-reflow/transition:"" dance -
# the same diff as the retired sw_flip_reset_animates.patch (2026-09-30: both
# mutants targeted the identical hunk, so one was dropped as redundant). This
# one is killed by BOTH E7 ("a flipped card keeps its back face during the
# fly-out and the next card arrives front-up") and N40 ("#next and
# ArrowRight on a flipped card deal without a reverse-flip transition") -
# E7 reaches step() via the swipe's own fly-out landing, N40 via #next/
# ArrowRight - so this file's `# kills:`/`# suite:` above name only the N40
# path; E7 kills it too but is not re-listed here.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -7847,10 +7847,7 @@ function step(dir) {
   if (!order.length) return;
   idx = (idx + dir + order.length) % order.length;
   // N40/OV2: suppress .card's reverse-flip transition across every reset.
-  card.style.transition = "none";
   flipped = false; render();
-  card.offsetHeight;
-  card.style.transition = "";
 }
 card.addEventListener("click", flip);
 // Bound to #card, so it fires for keys that BUBBLE from any descendant.

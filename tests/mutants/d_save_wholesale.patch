# kills: writing the app's own keys leaves a sibling key in hpfc untouched
# save() goes back to replacing the whole hpfc object, so any sibling key
# another feature stored there is silently dropped on the next write.
diff --git a/index.html b/index.html
index b018e51..4d4a07c 100644
--- a/index.html
+++ b/index.html
@@ -2398,11 +2398,7 @@ const deck = () => CUSTOM[deckId] || DECKS.find(d => d.id === deckId) || DECKS[0
 // settings there, so writing our two keys must not drop a sibling's.
 const save = () => {
   try {
-    const base = readStore(STORE_KEY);
-    const next = (base && typeof base === "object" && !Array.isArray(base)) ? base : {};
-    next.deck = storedDeck;
-    next.mode = mode;
-    localStorage.setItem(STORE_KEY, JSON.stringify(next));
+    localStorage.setItem(STORE_KEY, JSON.stringify({deck: storedDeck, mode}));
   } catch (e) {}
 };
 

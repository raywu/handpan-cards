# kills: writing the app's own keys leaves a sibling key in hpfc untouched
# suite: node --test --test-name-pattern ^writing.the.app.s.own.keys.leaves.a.sibling.key.in.hpfc.untouched$ tests/app.test.js
# save() goes back to replacing the whole hpfc object, so any sibling key
# another feature stored there is silently dropped on the next write.
# Approved retained contract mapped to the transactional instance adapter.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -9575,7 +9575,7 @@ function updateSettings(change) {
     const guarded = savedPreference(raw);
     if (!guarded.ok) return false;
     const base = guarded.value;
-    const next = { ...base };
+    const next = {};
     change(next);
     const encoded = JSON.stringify(next);
     if (encoded !== JSON.stringify(base)) localStorage.setItem(STORE_KEY, encoded);

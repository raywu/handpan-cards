# kills: iPadOS in desktop mode is still treated as iOS
# suite: node --test --test-name-pattern ^iPadOS.in.desktop.mode.is.still.treated.as.iOS$ tests/app.test.js
# Reviewer R2: iPadOS defaults to Request Desktop Website, so a real iPad
# sends a Macintosh UA and only the maxTouchPoints clause catches it. Without
# it an iPad falls through to the width rule and gets the 557.2 x 760.4pt wide
# sheet, which misses the printable box on both axes.
# Re-targeted 2026-09-29 (R1): isIOS() is a shared symbol that survives the
# legacy print-sheet retirement (it still gates the PDF-download path's
# navigation-vs-download branch on iOS). The mutated lines are unchanged in
# substance, only moved from :4201 to :6409 by the deletion of everything
# between PRINT_GEOM and openPrintSheet. The test this kills is narrowed to
# assert isIOS() directly rather than printLayoutName(), since printLayoutName
# itself is retired with the print sheet.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -6409,6 +6409,4 @@
 function isIOS(ua) {
   const s = String(ua || "");
-  return /iPad|iPhone|iPod/.test(s) ||
-    // iPadOS 13+ reports a desktop Macintosh UA but still has touch points.
-    (/Macintosh/.test(s) && typeof navigator !== "undefined" && navigator.maxTouchPoints > 1);
+  return /iPad|iPhone|iPod/.test(s);
 }

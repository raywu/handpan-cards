# A new flash adds to the old, so more than two seats are ringed.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -9225,7 +9225,7 @@ function swapSeats(ring, i, j) {
     next[i] = b.seat;
     next[j] = a.seat;
     setRingSeats(ring, next);
-    panFlash = [a.id, b.id];
+    panFlash = (panFlash || []).concat([a.id, b.id]);
     clearTimeout(flashTimer);
     flashTimer = setTimeout(() => { panFlash = null; repaintPlate(); }, 600);
   }

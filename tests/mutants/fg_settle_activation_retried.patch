diff --git a/tests/helpers/cdp.js b/tests/helpers/cdp.js
--- a/tests/helpers/cdp.js
+++ b/tests/helpers/cdp.js
@@ -381,7 +381,7 @@ class Browser {
       if (typeof sessionId !== "string" || !sessionId) {
         throw new Error("foreground settle requires an attached session");
       }

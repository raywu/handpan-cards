# kills: INTERMEDIATE deals a register-labelled anchor
# suite: node --test --test-name-pattern ^INTERMEDIATE.deals.a.register-labelled.anchor$ tests/sequence.test.js
# byMidiDescending breaks an equal-midi tie the wrong way round, so a bottom-shell field outranks the top-shell one.
diff --git a/src/engine/voicing.js b/src/engine/voicing.js
--- a/src/engine/voicing.js
+++ b/src/engine/voicing.js
@@ -86,7 +86,7 @@ var HPE = (typeof HPE !== "undefined") ? HPE : {};
 
   function byMidiDescending(a, b) {
     if (a.midi !== b.midi) return b.midi - a.midi;
-    if (a.top !== b.top) return a.top ? -1 : 1;
+    if (a.top !== b.top) return a.top ? 1 : -1;
     return a.id - b.id;
   }
 

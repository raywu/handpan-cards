 ul.rel a{display:flex;align-items:center;min-height:44px}
 section.related h2,section.group h2{color:var(--fg);font-size:20px;margin:0 0 4px}
 .prog{display:flex;flex-direction:column;align-items:center;gap:10px;position:relative}
-.prog>input{-webkit-appearance:none;appearance:none;position:absolute;bottom:0;left:calc(50% - 44px);width:88px;height:44px;opacity:0;margin:0;z-index:1;pointer-events:none;cursor:pointer;-webkit-tap-highlight-color:transparent;scroll-margin-top:min(301px,calc(100vh - 44px));scroll-margin-top:min(301px,calc(100svh - 44px))}
+.prog>input{-webkit-appearance:none;appearance:none;position:absolute;bottom:0;left:calc(50% - 44px);width:1px;height:1px;opacity:0;margin:0;z-index:1;pointer-events:none;cursor:pointer;-webkit-tap-highlight-color:transparent;scroll-margin-top:min(301px,calc(100vh - 44px));scroll-margin-top:min(301px,calc(100svh - 44px))}
 .prog>input:checked+input{left:auto;right:calc((100% - min(322px,100%))/2);pointer-events:auto}

# kills: Tab is trapped inside the settings panel and cycles every stop, wrapping both ways
# suite: node --test --test-name-pattern Tab.is.trapped.inside.the.settings.panel.and.cycles.every.stop..wrapping.both.ways tests/e2e.test.js
# Eng review amendment 1 (docs/plans/2026-10-01-resources-menu.md). Drops the
# Resources-links querySelectorAll from panelStops()'s returned array, so the
# #res-* anchors never join the panel's own Tab/Shift+Tab cycle: a
# keyboard user tabbing through the panel reaches "CHORD-ONLY PDF" and then
# wraps straight back to the trigger, skipping every Resources link entirely. Every other stop (modeA/B/S, the print controls,
# deck-add) is untouched, so only the forward-cycle assertion that now
# requires all three res-* ids to appear in `seen` can see this.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -14685,7 +14685,7 @@ function panelStops() {
           // ABOUT closes the list, so Tab follows what the eye sees.
           // Eng review amendment 1: the Resources links join the Tab trap
           // after the print controls, in DOM order.
-          ...(grid ? [...prints, ...scales, ...res, lang, about] : [...scales, ...prints, ...res, about, lang])]
+          ...(grid ? [...prints, ...scales, lang, about] : [...scales, ...prints, about, lang])]
     .filter(isStop);
 }
 function openPanel() {

-      (("mirrorBottom" in seed) ? !!seed.mirrorBottom : top);
+    var bottom = ("mirrorBottom" in seed) ? !!seed.mirrorBottom :
+      (("mirrorBottom" in call) ? !!call.mirrorBottom : top);
     return { top: top, bottom: bottom };
   }
 

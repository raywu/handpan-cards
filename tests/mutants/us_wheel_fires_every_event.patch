# kills: US-3 one wheel gesture over WHEEL_COMMIT_PX steps once
# suite: node --test --test-name-pattern ^US-3.one.wheel.gesture.over.WHEEL_COMMIT_PX.steps.once$ tests/app.test.js
# Drops the `if (w.fired) return { kind: "hold", ... }` latch in
# wheelDecision(): a wheel gesture no longer latches after it commits, so
# every further event of the same gesture starts another fly-out and the deck steps more than once.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8937,7 +8937,6 @@ function wheelDecision(w, { deltaX, deltaY, deltaMode, innerHeight }) {
   const dx = deltaX * scale, dy = deltaY * scale;
   const axis = w.axis === null && (dx !== 0 || dy !== 0) ? (Math.abs(dx) > Math.abs(dy) ? "x" : "y") : w.axis;
   if (axis !== "x") return { kind: "pass", axis, sx: w.sx, dir: 0 };
-  if (w.fired) return { kind: "hold", axis, sx: w.sx, dir: 0 };
   const sx = w.sx + dx;
   // sx > 0 means the fingers moved right-to-left (positive deltaX) -> next
   // card, content follows the fingers (plan: docs/plans/2026-09-30-

# kills: TR-1: the three site links are equal in width on every line they share, and every label stays inside its box
# suite: node --test --test-name-pattern TR-1: tests/e2e.test.js
# Excess site padding consumes the narrow targets and overflows the equal-width row. Restoring default11px is no longer necessarily a behavioral fault.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -320,7 +320,7 @@ a.mode{text-decoration:none}
 /* The three sites share one equal-width row, including the narrow sidebar.
    Complete labels wrap inside their targets without changing typography. */
 .modebar.trio{flex-wrap:nowrap}
-.modebar.trio .mode{min-width:0; padding-inline:4px; line-height:1.25; overflow-wrap:anywhere}
+.modebar.trio .mode{min-width:0; padding-inline:40px; line-height:1.25; overflow-wrap:anywhere}
 #settings-trigger[aria-expanded="true"]{background:#f1ece1; color:#272219; border-color:#f1ece1}
 .sr-only{position:absolute; width:1px; height:1px; margin:-1px; padding:0; border:0;
   overflow:hidden; white-space:nowrap; clip:rect(0 0 0 0)}

# kills: UNDECLARED_PARENS: parenthesised notes get no role and nothing is serialised
# suite: node --test --test-name-pattern ^UNDECLARED.PARENS..parenthesised.notes.get.no.role.and.nothing.is.serialised$ tests/import.test.js
# A parenthesised note is given the top role instead of staying unassigned, so
# a ( ) the source never declared as a ding is read as part of the scale.
diff --git a/src/engine/importer.js b/src/engine/importer.js
--- a/src/engine/importer.js
+++ b/src/engine/importer.js
@@ -468,7 +468,7 @@
       if (n === ding) n.assigned = "ding";
       else if (pickable && contested && n.role === "ding" && !n.paren && clauses[n.list].length === 1) n.assigned = "dropped";
       else if (n.paren && parensBottom) { n.assigned = "bottom"; n.inline = true; }
-      else if (n.paren) n.assigned = "unknown";
+      else if (n.paren) n.assigned = "top";
       else n.assigned = n.role === "ding" ? "top" : n.role;
     });
     var dropped = notes.filter(function (n) { return n.assigned === "dropped"; });

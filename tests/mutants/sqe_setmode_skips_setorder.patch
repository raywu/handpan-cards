--- a/index.html
+++ b/index.html
@@ -8672,7 +8672,7 @@ function setMode(m) {
   document.getElementById("foot").classList.toggle("seq", m === "S");
   document.getElementById("seq-style").hidden = m !== "S";
   syncShuffleLabel();
-  if (wasS !== (m === "S")) setOrder();
+  if (false) setOrder();
   render();
 }

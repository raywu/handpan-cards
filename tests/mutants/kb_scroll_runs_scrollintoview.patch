# kills: KB: a visualViewport scroll event does not reveal the focused field, a resize does
# suite: node --test --test-name-pattern ^KB..a.visualViewport.scroll.event.does.not.reveal tests/e2e.test.js
# The scroll-event early return goes, so a visualViewport scroll reveals the focused field and can re-fire the event that called it.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -13190,7 +13190,6 @@ function applyKbOffset(e) {
   setSheetClass("tiny", kb && high > 0 && high < 200);
   lipKbEdge(wasUp, kb);
   syncBand();
-  if (e && e.type === "scroll") return;
   const at = document.activeElement;
   if (at && at.matches && at.matches("input, textarea")) revealField(at);
 }

# kills: PM rule 3: DOWNLOAD PDF names and builds the chord-only file, byte for byte what main built
# suite: node --test --test-name-pattern PM.rule.3 tests/app.test.js
# Lane PM. DOWNLOAD PDF asks for the 'full' variant, so a tap builds the full deck instead of the chord-only sheets.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -1991,7 +1991,7 @@ html.about-open{overflow:hidden}
       <div id="print-menu" role="menu" aria-label="PDF download options" hidden>
         <button type="button" role="menuitem" id="print-pdf-easy" onclick="downloadDeckPDF('shop', this, 'easy'); closePanel();">EASY</button>
         <button type="button" role="menuitem" id="print-pdf-easy_medium" onclick="downloadDeckPDF('shop', this, 'easy_medium'); closePanel();">EASY + MEDIUM</button>
-        <button type="button" role="menuitem" id="print-pdf-all" onclick="downloadDeckPDF('shop', this, 'all'); closePanel();">ALL</button>
+        <button type="button" role="menuitem" id="print-pdf-all" onclick="downloadDeckPDF('full', this, 'all'); closePanel();">ALL</button>
       </div>
       <!-- The paper choice keeps the panel open (design direction, "After an
            action"): the next tap is a print button, not a new task. -->

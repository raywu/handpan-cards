# kills: a generated deck survives a reload, rebuilt from its saved seed
# suite: node --test --test-name-pattern ^a.generated.deck.survives.a.reload..rebuilt.from.its.saved.seed$ tests/app.test.js
# Boot stops rebuilding the saved scales, so a custom deck does not survive a
# reload and its stored id silently falls back to a built-in.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -11423,7 +11423,6 @@ sheet.setAttribute("hidden", ""); buildSwatches(); paintLayout(); resyncSheet(tr
 // Saved scales are rebuilt BEFORE the stored deck id is resolved, so a custom
 // deck that was selected last session is in the registry by the time deck()
 // looks for it.
-restoreScales();
 const routedDeck = routedDeckId();
 bootStored = typeof store.deck === "string" ? store.deck : null;
 if (routedDeck) deckId = routedDeck;

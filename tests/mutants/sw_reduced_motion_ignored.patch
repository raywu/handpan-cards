# kills: card swipe: under reduced motion the swipe steps instantly with no animation
# suite: node --test --test-name-pattern ^card.swipe:.under.reduced.motion.the.swipe.steps.instantly.with.no.animation$ tests/e2e.test.js
# Drops the reduced-motion early return in release(): a committing swipe
# always plays the WAAPI fly-out/enter animation and never steps instantly,
# even when prefers-reduced-motion is set.
# Refreshed 2026-10-01 (lane A, quality-refactor finding 13): this branch now
# calls the shared swipeRest() instead of re-implementing its
# scene.style.transform/willChange reset inline, so the removed block is
# shorter than before, but the mutation itself (dropping the whole
# reduced-motion branch, including the `if (dir) step(dir); return;` that
# makes the swipe commit instantly) is unchanged.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8284,16 +8284,6 @@ function release(e, cancelled, pushPoint = true) {
   // click can arrive a tick or more after this runs - touch/pen keep the
   // immediate decay, since their synthesized click (if any) follows at once.
   if (moved && !cancelled) setEatClick(true, pointerType === "mouse" ? 400 : 0);
-  if (reducedMotion.matches) {
-    // Was its own scene.style.transform/willChange reset, byte-for-byte the
-    // same as swipeRest() - re-implemented, not duplicated-by-reference, so a
-    // future rest-state change here could drift from the other four sites
-    // that already call swipeRest() (finding 13, quality-refactor plan
-    // 2026-09-30).
-    swipeRest();
-    if (dir) step(dir);
-    return;
-  }
   if (!dir) { springBack(dx); return; }
   flyOut(dir, dx, pointerType === "mouse" ? vx : null);
 }

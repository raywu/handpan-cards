# and breaks a run of letters, so Underside: F and G is dropped silently.
diff --git a/src/engine/importer.js b/src/engine/importer.js
--- a/src/engine/importer.js
+++ b/src/engine/importer.js
@@ -92,7 +92,7 @@
         if (run >= 2) return true;
       } else if (tok === ":") {
         key = /^keys?$/i.test(prev);
-      } else if (!/^(?:[^A-Za-z0-9.]|and|or)$/i.test(tok)) {
+      } else if (!/^(?:[^A-Za-z0-9.]|or)$/i.test(tok)) {
         run = 0;
         key = false;
       } else if (!/^(?:[,\/\-&]|and|or)$/i.test(tok)) key = false;

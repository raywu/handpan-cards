# kills: releaseDecision: a tap that never moved rests with no hop and eats no click
# suite: node --test --test-name-pattern ^releaseDecision..a.tap.that.never.moved.rests.with.no.hop.and.eats.no.click$ tests/swipe.test.js
# Q9: drops the early return that skips the spring-back animation for a
# touch that never left the slop radius. Without it, every non-committing
# release (including a jitter that moved 0px) runs the full swipeXf/
# SWIPE_BACK_MS animate() call, producing a visible jitter hop on a touch
# that was never meant to move the card at all.
# Context-refreshed 2026-09-30 (S2, bounce 1): the trailing context (the
# comment right after the guard) was rewritten from the old "Q17" text back
# to base's cancelled/eatClick comment as part of restoring the setTimeout(0)
# decay - the mutation itself (deleting the early-return guard) is unchanged.
# Context-refreshed 2026-09-30 (desktop-swipe lane): hunk context updated for release()/lpc/wheel refactor (setEatClick, flyOut/springBack, pushPoint); the mutation itself is unchanged.
# Re-cut 2026-10-03 (AP1-a): release() now executes releaseDecision() and both pointerdown sites call canStartGesture(); the mutation is re-expressed on the new site, intent unchanged.
# Re-anchored to src/engine/swipe.js (App UX P1); the unit case in tests/swipe.test.js kills it.
diff --git a/src/engine/swipe.js b/src/engine/swipe.js
--- a/src/engine/swipe.js
+++ b/src/engine/swipe.js
@@ -30,7 +30,6 @@ HPE.swipe = (function () {
   function swipeXf(dx) { return `translate3d(${dx}px,0,0) rotate(${swipeTilt(dx)}deg)`; }
   function releaseDecision({ dx, dy, vx, moved, cancelled, blocked, reducedMotion }) {
     const dir = blocked ? 0 : swipeDecision(dx, dy, vx);
-    if (!dir && !moved) return { kind: "rest", dir: 0, eatClick: false };
     const eatClick = moved && !cancelled;
     if (reducedMotion) return { kind: "rest", dir, eatClick };
     return { kind: dir ? "fly" : "spring", dir, eatClick };

# kills: SAVE CHANGES is reachable without scrolling on the largest pan the engine allows
# suite: node --test --test-name-pattern ^SAVE.CHANGES.is.reachable.without.scrolling.on.the.largest.pan.the.engine.allows$ tests/e2e.test.js
# The surface stops being a flex column, so .sheetbody no longer takes the
# space the header and footer leave. The whole page flows past the viewport
# and the primary sits below the fold on open.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -413,7 +413,7 @@
 .sheetsurf{width:100%; max-width:520px; background:#1f1b15;
   height:100dvh; max-height:100dvh; overflow-y:auto; overscroll-behavior:contain;
   padding:var(--sp-3) var(--sp-4) max(var(--sp-4), env(safe-area-inset-bottom));
-  display:flex; flex-direction:column; gap:var(--sp-4)}
+  display:block}
 /* The header row: BACK, then the page title. Outside .sheetbody like the
    footer, so the way out of the page is never scrolled off the top - which is
    the drawer's grab handle replaced by something that does a job. */

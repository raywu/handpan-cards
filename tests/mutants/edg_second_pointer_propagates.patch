   editorEl("editor-pan").addEventListener("focusin", editorPanFocus);
-  editorEl("editor").addEventListener("pointerdown", (e) => { if (editorDrag && e.pointerId !== editorDrag.id) { e.stopImmediatePropagation(); editorDragEnd(null); } });
+  editorEl("editor").addEventListener("pointerdown", (e) => { if (editorDrag && e.pointerId !== editorDrag.id) { editorDragEnd(null); } });
   editorEl("editor").addEventListener("pointerdown", editorDragDown);
   editorEl("editor").addEventListener("contextmenu", (e) => { if (editorDrag) e.preventDefault(); });
   editorEl("editor-oct-down").onclick = () => editorTrayView({ oct: editorView(editorSession.history.present).oct - 1 });

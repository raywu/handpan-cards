# fault: The second-pointer guard no longer stops the event, so the same press reaches the drag-down handler on the editor and arms a new drag.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -15010,7 +15010,7 @@ function editorWire() {
   editorEl("editor-pan").onclick = editorPanClick;

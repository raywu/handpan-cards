# kills: RESET puts the generated layout back in one keyboard action
# suite: node --test --test-name-pattern ^RESET.puts.the.generated.layout.back.in.one.keyboard.action$ tests/e2e.test.js
# RESET is not wired up, so the only way back to the generated layout is to
# undo every correction by hand.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -4829,7 +4829,7 @@ rotL.onclick = () => rotateLayout(-1);
 rotR.onclick = () => rotateLayout(1);
 moveL.onclick = () => moveNote(-1);
 moveR.onclick = () => moveNote(1);
-resetBtn.onclick = resetLayout;
+resetBtn.onclick = () => {};
 // A tap anywhere on the pan chooses the note under it. Delegated to the plate
 // rather than bound per target, because the targets are rewritten on every
 // repaint and a listener per circle would be re-attached on every keystroke.

# kills: arrow keys and Enter/Space do not reach the card while the settings panel is open
# suite: node --test --test-name-pattern ^arrow.keys.and.Enter.Space.do.not.reach.the.card.while.the.settings.panel.is.open$ tests/e2e.test.js
# Moves the document keydown handler's panelOpen `return` inside the Tab
# branch only, so any other key (ArrowRight/ArrowLeft/Enter/Space) typed
# while the panel is open falls through to the ArrowRight/ArrowLeft check
# below instead of being swallowed by the panel.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -7702,8 +7702,8 @@ document.addEventListener("keydown", e => {
       const next = e.shiftKey ? (i <= 0 ? stops.length - 1 : i - 1) : (i === stops.length - 1 ? 0 : i + 1);
       e.preventDefault();
       stops[next].focus();
+      return;
     }
-    return;
   }
   if (e.key === "ArrowRight") step(1);
   else if (e.key === "ArrowLeft") step(-1);

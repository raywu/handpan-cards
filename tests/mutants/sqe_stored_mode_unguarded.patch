# kills: stored mode "S" reads back; unrecognised stored modes read as "A"
# suite: node --test --test-name-pattern ^stored.mode..S..reads.back..unrecognised.stored.modes.read.as..A.$ tests/app.test.js
# Lane S2. Drops "S" from the boot-time allow-list, so a stored mode of "S"
# is treated as unrecognised and silently downgrades to "A" on every reload -
# PLAY A SEQUENCE never survives a page refresh.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -9776,7 +9776,7 @@ function applyLang() {
 // take the share-link handler at the end of the script down with it.
 // S2: only "A"/"B"/"S" survive the read; a future-version or corrupted value
 // (a stray "C", a non-string, etc.) reads back as "A" instead of propagating.
-let mode   = ["A", "B", "S"].includes(store.mode) ? store.mode : "A";  // A: name->notes, B: notes->name, S: sequence
+let mode   = ["A", "B"].includes(store.mode) ? store.mode : "A";  // A: name->notes, B: notes->name, S: sequence
 // Difficulty (sequence-difficulty plan D-7): type-guarded like mode, so a
 // corrupted/future value reads back as "basic" rather than propagating.
 let tier = ["basic", "intermediate", "advanced"].includes(store.tier) ? store.tier : "basic";

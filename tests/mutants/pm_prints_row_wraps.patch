# kills: every row of the settings panel is flush: each visual line spans the row from edge to edge
# suite: node --test --test-name-pattern every.row.of.the.settings.panel.is.flush tests/e2e.test.js
# Lane PM. The print row wraps again and DOWNLOAD PDF takes a whole line, so the paper select falls onto a second one.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -665,7 +665,7 @@ main{overflow-x:clip}
    panel's own .mode-sized controls, which is also what clears the 44px
    target floor (eng review C4). No new colour: these reuse `.mode`'s own
    surface, border and text tokens. */
-.prints{display:flex; flex-wrap:nowrap; gap:var(--sp-2); position:relative}
+.prints{display:flex; flex-wrap:wrap; gap:var(--sp-2); position:relative}
 /* The tier menu (DOWNLOAD PDF): a popup under the row, out of the flex flow, so opening
    it never changes the row height or the trigger width. Its items are .prints buttons,
    so they keep every themed .prints button rule (colours, :lang() fonts, 44px floor,
@@ -683,7 +683,7 @@ main{overflow-x:clip}
   border-radius:8px; padding:7px 11px 6px; min-height:44px; cursor:pointer;
   white-space:nowrap; -webkit-appearance:none; appearance:none}
 .prints button, #lang-select{flex:1 1 auto}
-.prints #print-download{flex:3 1 auto; padding-left:6px; padding-right:6px}
+.prints #print-download{flex:1 0 100%; padding-left:6px; padding-right:6px}
 .prints button, #lang-select{text-align:center; text-align-last:center}
 .prints button:hover, .prints button:focus-visible,
 #lang-select:hover, #lang-select:focus-visible{background:#2e281e}

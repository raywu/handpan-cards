# kills: KB: F4 on the Layout tab at 320x568 at least 160px of options show under the large pan and the pan is at least 140px
# suite: node --test --test-name-pattern ^KB..F4.on.the.Layout.tab.at.320x568.at.least.160px.* tests/e2e.test.js
# The room kept for the controls under the pan is dropped, so the pan eats the viewport.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -1047,7 +1047,7 @@
 #scale-or{display:flex; align-items:center; gap:var(--sp-3)}
 #scale-or::before, #scale-or::after{content:""; flex:1 1 0; height:1px; background:#433b2c}
 #scale-or span{font:600 9.5px/1.5 "Nunito Sans"; letter-spacing:.13em; color:#a79d8b; text-transform:uppercase}
-#scale-preview{--adj-reserve:232px;
+#scale-preview{--adj-reserve:0px;
   width:clamp(160px, min(100cqw, calc(100cqh - var(--adj-reserve))), 480px)}
 #scale-plate-band{position:sticky; top:0; z-index:2; background:#1f1b15; padding-bottom:var(--sp-1)}
 .sheetbody:has(#scale-layout-zone.nostick) #scale-plate-band{position:static}

# kills: fromGenerated prints the short line for SMALL_LABELS and the capitalised reason for NO_THIRDS
# suite: node --test --test-name-pattern ^fromGenerated.prints.the.short.line.for.SMALL_LABELS.and.the.capitalised.reason.for.NO_THIRDS$ tests/pdfcards.test.js
# The browser's blurb ignores TITLE_WARNINGS, so a crowded pan printed from
# the app carries the whole sentence off the edge of the title card.
diff --git a/src/engine/pdfdeck.js b/src/engine/pdfdeck.js
--- a/src/engine/pdfdeck.js
+++ b/src/engine/pdfdeck.js
@@ -114,8 +114,7 @@
     // that the app had flagged it; the engine's own reason string, verbatim, unless TITLE_WARNINGS has a
     // shorter line that fits the card.
     warnings.forEach(function (w) {
-      out.push(Object.prototype.hasOwnProperty.call(TITLE_WARNINGS, w.code)
-        ? TITLE_WARNINGS[w.code] : String(w.reason).toUpperCase());
+      out.push(String(w.reason).toUpperCase());
     });
     return out;
   }

# kills: tierOf returns null for a sequence ADVANCED can never deal
# classifyTier's ADVANCED catch-all is back to any length >= 3, so an
# undealable 3-chord or 7-chord sequence is labelled "advanced" again
# suite: node --test --test-name-pattern ^tierOf.returns.null.for.a.sequence.ADVANCED.can.never.deal$ tests/sequence.test.js
diff --git a/src/engine/sequence.js b/src/engine/sequence.js
--- a/src/engine/sequence.js
+++ b/src/engine/sequence.js
@@ -386,7 +386,7 @@ var HPE = (typeof HPE !== "undefined") ? HPE : {};
     if (intermediateGate(deck, chords, ctx.home, ctx.anchorsList)) {
       return "intermediate";
     }
-    if (n >= 4 && n <= 6) return "advanced";
+    if (n >= 3) return "advanced";
     return null;
   }
 

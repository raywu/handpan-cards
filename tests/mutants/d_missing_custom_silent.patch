# kills: an unknown BUILT-IN deck id falls back silently; a missing custom: id says so
# suite: node --test --test-name-pattern ^an.unknown.BUILT.IN.deck.id.falls.back.silently..a.missing.custom..id.says.so$ tests/app.test.js
# The missing-custom-deck fallback goes silent, so a user whose saved scale is
# gone just sees a different deck with no explanation.
# Approved retained contract mapped to the transactional instance adapter.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -15526,7 +15526,7 @@ function finishSavedBoot() {
     if(savedState && !incomingShare && wanted && wanted!==deck().id &&
         !(savedState?.slots[wanted] && savedState.slots[wanted]===selection.id) &&
         (wanted.indexOf("custom:")===0 || savedState?.hidden.includes(wanted)))
-      say(t("boot.gone",{name:deck().name}),"warn");
+      void wanted;
     booted=true;bootStored=null;
     if(incomingAdd && savedMode!=="protected")openScaleSheet(desktopMQ.matches ? addChip : settingsTrigger);
   };

# kills: DR1 rule G by resize: open on Edit, rotate in either direction, and the band and padding follow
# suite: node --test --test-name-pattern ^DR1.rule.G.by.resize.* tests/drawer_grid.test.js
# Neither the plate band nor the sheet body is observed and the keyboard offset no longer calls syncBand,
# so a shrinking scrollport leaves the stuck state stale (rule G-e).
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -10593,8 +10593,6 @@ function syncBand() {
 const bandPort = document.querySelector(".sheetbody") || plateBand;
 if (typeof ResizeObserver === "function") {
   const bandWatch = new ResizeObserver(syncBand);
-  bandWatch.observe(plateBand);
-  bandWatch.observe(bandPort);
   bandWatch.observe(drawerStatus);
 }
 /** A native focus scrolls a text control only far enough to show its caret;
@@ -11691,7 +11689,6 @@ function applyKbOffset(e) {
   setSheetClass("side", high > 0 && high < 420);
   setSheetClass("tiny", kb && high > 0 && high < 200);
   lipKbEdge(wasUp, kb);
-  syncBand();
   if (e && e.type === "scroll") return;
   const at = document.activeElement;
   if (at && at.matches && at.matches("input, textarea")) revealField(at);

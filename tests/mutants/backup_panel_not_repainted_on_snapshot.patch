# kills: the export page on desktop shows the new scale after a save
# suite: node --test --test-name-pattern ^the.export.page.on.desktop.shows.the.new.scale.after.a.save tests/app.test.js
# The saved-scales snapshot listener no longer repaints an open backup panel, so on desktop (which never calls openPanel) the list stays stale after a save.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -18372,7 +18372,6 @@ savedSnapshotListener=event=>{
     !savedEqual(event.previous.hidden, savedState.hidden) ||
     !savedEqual(oldSelection, selection);
   if (chipsChanged) buildChips();
-  if (chipsChanged && subpage === "export") paintBackup();
   updateSavedStatus();
   if(!dirty && !sheetOpen){
     if(!savedEqual(oldSelection,selection) || beforeRow?.revision!==afterRow?.revision){setOrder();render();}

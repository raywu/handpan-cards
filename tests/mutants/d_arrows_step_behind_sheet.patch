# kills: arrow keys do not step the card while the sheet is open
# suite: node --test --test-name-pattern ^arrow.keys.do.not.step.the.card.while.the.sheet.is.open$ tests/app.test.js
# Arrow keys still step the practice deck while the sheet is open, so moving
# the caret inside the scale box shuffles the card behind it.
#
# Refreshed 2026-09-28 (lane M1, menu-shell): the settings panel's own
# keydown block (panelOpen) now sits between the sheetOpen block and the
# ArrowRight/ArrowLeft handling, so the old hunk's trailing context (the
# arrow-key lines immediately after the closing brace) no longer sits next
# to this code. Re-anchored on the lines that still are adjacent; the
# defect and the fix are unchanged.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -7707,6 +7707,5 @@ document.addEventListener("keydown", e => {
   // arrow key is cursor movement inside the box, never a card step.
   if (sheetOpen) {
     if (e.key === "Escape") { e.preventDefault(); closeScaleSheet(); }
-    return;
   }
   // While the settings panel is open it owns the keyboard too (eng review

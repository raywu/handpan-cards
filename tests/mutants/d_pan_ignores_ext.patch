# kills: pan() sizes a generated deck's viewBox from the solver's ext
# suite: node --test --test-name-pattern ^pan...sizes.a.generated.deck.s.viewBox.from.the.solver.s.ext$ tests/app.test.js
# pan() re-derives the extent instead of reading the one layout.solve computed,
# so a generated pan is cropped or padded wrongly (ENGINE-SPEC section 11).
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -3741,8 +3741,7 @@
   const hasBottom = !!g.bottom;
   // Generated decks carry the solver's own extent (ENGINE-SPEC section 11);
   // the built-in geom literals have no ext key, so they keep the derivation.
-  const ext = g.ext ? R * g.ext
-            : hasBottom ? R * (g.bottom + g.r_bnote + g.n_out) + 14 : R * 1.06;
+  const ext = hasBottom ? R * (g.bottom + g.r_bnote + g.n_out) + 14 : R * 1.06;
   // data-ext travels with the interactive layer because the hit radius can only
   // be computed from the MEASURED width, and the sizer needs the viewBox scale
   // to convert CSS pixels into it. The card path emits neither.

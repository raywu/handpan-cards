# kills: AP2-3 a throwing generate still restores readonly and the label and leaves the button disabled
# suite: node --test --test-name-pattern ^AP2-3.a.throwing.generate.still.restores.readonly.and.the.label.and.leaves.the.button.disabled$ tests/app.test.js
# runGenerate restores readonly and the label in a finally; this restores them only on
# the non-throwing path, so a generate that throws leaves the box read-only and the
# button reading GENERATING.
# Retained behavior re-anchored for saved instances; exact intent is recorded in the lane evidence.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -13507,7 +13507,7 @@ async function runGenerate(separate = false) {
     track("scale_create",{note_count:Object.keys(d.fields).length,has_bottom:Object.values(d.fields).some(f=>f[3]==="bottom")?1:0});
     say((base?t("sheet.updated",{name:d.name}):t("sheet.generated",{n:d.chords.length}))+(warned.length?" "+warned.join(" "):""),warned.length?"warn":"ok");
   } finally {
-    if(savePending===operation){savePending=null;if(generation===sheetGeneration){genBtn.textContent=label;refreshSavedSubmit();}}
+    if(!buildRefused && savePending===operation){savePending=null;if(generation===sheetGeneration){genBtn.textContent=label;refreshSavedSubmit();}}
   }
 }
 document.getElementById("scale-conflict-separate").onclick=()=>runGenerate(true);

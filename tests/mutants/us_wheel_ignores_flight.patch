# A wheel gesture arriving during a live fly-out is no longer skipped, so 
# trackpad momentum right after a flight starts a second fly-out and 
# double-steps.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -15267,7 +15267,7 @@ if (wheelMain) wheelMain.addEventListener("wheel", e => {
   wheel.axis = d.axis;
   if (d.kind === "skip" || d.kind === "pass") return; // vertical-dominant: never claimed, never preventDefault-ed
   e.preventDefault();
-  if (d.kind === "hold" || flight) return;
+  if (d.kind === "hold") return;
   wheel.sx = d.sx;
   if (d.kind === "commit") {
     wheel.fired = true;

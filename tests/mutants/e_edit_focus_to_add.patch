# kills: Escape closes the Edit sheet and focus returns to the chip that opened it
# suite: node --test --test-name-pattern ^Escape.closes.the.Edit.sheet.and.focus.returns.to.the.chip.that.opened.it$ tests/e2e.test.js
# Every close hands focus to + ADD - but addChip (#deck-add) now lives inside
# the settings panel (M2, 2026-09-28), which is `hidden` whenever the Edit
# sheet is open, and a hidden element refuses focus. So addChip.focus() is a
# no-op: it does not land the keyboard user on "+ Add a scale", it drops them
# on document.body with no visible focus ring at all - worse than the stated
# defect, not merely a wrong destination. Either way, focus is not returned
# to the chip that opened the Edit sheet, which is what the test asserts.
# Retained behavior re-anchored for saved instances; exact intent is recorded in the lane evidence.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -13402,7 +13402,7 @@ function hideSheet() {
   const openerTag=sheetOpenerSelection;
   if(savedState){selection=savedResolve(selection,savedState,savedEntries);setOrder();buildChips();render();}
   const liveOpener=openerTag?[...document.getElementById("decks").children].find(chip=>chip.getAttribute("data-selection-kind")===openerTag.kind && chip.getAttribute("data-selection-id")===openerTag.id):sheetOpener;
-  (liveOpener || document.querySelector("#decks .chip.on") || addChip).focus();
+  addChip.focus();
   sheetOpener = null;sheetOpenerSelection=null;
 }
 // The app's own way out: BACK, Escape, or a save that finishes. It pops the

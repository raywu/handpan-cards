# kills: swipeDecision commits strictly past SWIPE_COMMIT_PX, left = next
# suite: node --test --test-name-pattern ^swipeDecision.commits.strictly.past.SWIPE_COMMIT_PX..left...next$ tests/app.test.js
# Turns the strict "past the threshold" commit into "at or past it", so a
# drag that lands EXACTLY on SWIPE_COMMIT_PX now commits - the spec's own
# `swipeDecision(18,0) === 0` boundary case goes the other way.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8076,7 +8076,7 @@ function swipeDecision(dx, dy, vx) {
   // SWIPE_* threshold, is what keeps a vertical drag from ever navigating.
   if (Math.abs(dy) > Math.abs(dx)) return 0;
   const fling = Math.abs(dx) > SWIPE_SLOP_PX && Math.abs(vx) > SWIPE_FLING_PX_MS && vx * dx > 0;
-  return Math.abs(dx) > SWIPE_COMMIT_PX || fling ? (dx < 0 ? 1 : -1) : 0;
+  return Math.abs(dx) >= SWIPE_COMMIT_PX || fling ? (dx < 0 ? 1 : -1) : 0;
 }
 function swipeTilt(dx) {

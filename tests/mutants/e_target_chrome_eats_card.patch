# kills: the header and footer stay inside their pixel budget, so the card keeps its size
# suite: node --test --test-name-pattern ^the.header.and.footer.stay.inside.their.pixel.budget..so.the.card.keeps.its.size$ tests/e2e.test.js
# Replaces the chrome margins that come off the spacing ramp with fixed,
# generous literals - the kind of "a bit more air" edit this lane's brief
# invites. Nothing about the controls changes - every target is still 44px and
# still hit-tests to itself - so every tap-target assertion stays green. What
# moves is `main`, and because .scene is height:min(100%, ...) that comes
# straight off the card: ~45px of it in landscape. assertCardFits CANNOT see
# this, because its expectation min(cardW, main.height * ratio) is derived
# from the very quantity that moved. Only a guard with a FIXED expectation
# catches it.
# Re-targeted 2026-09-28 (lane M1, menu-shell): h1's own margin moved into
# .hrow (h1 is now a grid item with margin:0) and .modebar left the header
# entirely for the settings panel, so this mutant now hits the three margins
# that still contribute to the header/footer chrome the budget test measures:
# header's own margin-bottom, .hrow's new margin-bottom, and footer's
# margin-top.
# Re-targeted 2026-09-29 (lane S2): the footer became a CSS grid (prev/rail/
# next/shuffle), so its margin-top now sits on the rule's opening line rather
# than its own trailing line. Same three margins, new line anchors.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -123,12 +123,12 @@
    tests/e2e.test.js "the header and footer stay inside their pixel budget"
    pins this against measured numbers. assertCardFits CANNOT: it derives its
    expectation from the current main height, so it moves with the regression.
    ------------------------------------------------------------------------ */
-header{width:100%; max-width:520px; text-align:center; margin-bottom:var(--sp-3)}
+header{width:100%; max-width:520px; text-align:center; margin-bottom:20px}
 /* The h1 row: a 44px|1fr|44px grid so the title stays optically centred once
    a 44px settings trigger sits beside it. The spacer is the trigger's mirror
    image, not decoration for its own sake - without it the title drifts right
    by half the trigger's width. */
 .hrow{display:grid; grid-template-columns:44px 1fr 44px; align-items:center;
-  gap:var(--sp-2); margin-bottom:var(--sp-2)}
+  gap:var(--sp-2); margin-bottom:16px}
 .hspacer{width:44px; height:44px}
@@ -512,6 +512,6 @@
    carries no box of its own (display:contents): it is markup grouping only,
    so its children (.count, .shuffle) participate in this grid directly. */
-footer{width:100%; max-width:520px; margin-top:var(--sp-3);
+footer{width:100%; max-width:520px; margin-top:20px;
   display:grid; grid-template-columns:56px 1fr 56px; grid-template-rows:auto auto;
   align-items:center; column-gap:var(--sp-2); row-gap:0}
 button.nav{grid-row:2; width:56px; height:44px; border-radius:10px; border:1px solid #433b2c;

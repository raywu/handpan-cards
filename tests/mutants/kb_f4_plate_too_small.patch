# kills: KB: F4 with the drawer open at 320x568 every note on the shrunk pan is hit by a tap at its centre (pygmy)
# suite: node --test --test-name-pattern ^KB..F4.with.the.drawer.open.at.320x568.every.note.on.the.shrunk.pan.* tests/e2e.test.js
# The open-drawer plate is capped at 90px, so on a crowded pan neighbouring notes overlap and a tap
# at a note's centre no longer reaches that note.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -1053,7 +1053,7 @@
 .scalestage > #scale-plate-band{position:sticky; top:0; z-index:2; background:#1f1b15;
   padding-bottom:var(--sp-1)}
 .scalestage #scale-preview{width:clamp(110px, calc(100cqh - 260px), 300px); max-width:none}
-.sheetbody:has(#scale-layout-zone.open) #scale-preview{width:100%; max-width:min(300px, 31dvh)}
+.sheetbody:has(#scale-layout-zone.open) #scale-preview{width:100%; max-width:min(300px, 90px)}
 .sheetbody:has(#scale-layout-zone.open):has(input:focus, textarea:focus, #scale-swatches button:focus)
   #scale-plate-band{position:static}
 .sheetbody:has(#scale-layout-zone.nostick) #scale-plate-band{position:static}

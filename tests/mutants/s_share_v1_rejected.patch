# suite: node --test --test-name-pattern ^a.v1.link.emitted.by.an.older.app.still.decodes.here..deck.unchanged$ tests/share.test.js
# kills: a v1 link emitted by an older app still decodes here, deck unchanged
# The naked version bump: decode reads only the version it writes, so every
# link ever shared becomes a corrupt payload the day the format grows.
diff --git a/src/engine/share.js b/src/engine/share.js
--- a/src/engine/share.js
+++ b/src/engine/share.js
@@ -599,7 +599,7 @@ var HPE = (typeof HPE !== "undefined") ? HPE : {};
     // while making every version this build knows decodable, so a v1 link
     // still opens in a v2 app and only a genuinely NEWER one is refused.
     var newest = HPE.core.PROFILE_ENABLED ? PROFILE_VERSION : NEWEST;
-    var VERSION = Math.max(OLDEST, Math.min(INDEX[text.charAt(0)], newest));
+    var VERSION = newest;
 
     // 1. The cap is the FIRST gate: an over-cap link is refused on length,
     //    before the version byte and before any parsing at all.

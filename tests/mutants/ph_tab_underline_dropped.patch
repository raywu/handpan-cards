# kills: PH: 380x780 the tabs are a text strip with a 2px cream underline on the selected one, 44px tall
# suite: node --test --test-name-pattern ^PH:.380x780.the.tabs.are.a.text.strip tests/e2e.test.js
# Drops the selected tab's underline, so Scale and Layout no longer read as tabs.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -1084,7 +1084,6 @@ footer.seq{row-gap:var(--sp-1)}
   color:#a79d8b; font:600 10.5px/1 "Nunito Sans"; letter-spacing:.13em; text-transform:uppercase; cursor:pointer}
 #scale-tabs [role=tab].on{color:#f1ece1}
 #scale-tabs [role=tab]::after{content:""; position:absolute; left:0; right:0; bottom:-1px; height:2px; background:transparent}
-#scale-tabs [role=tab].on::after{background:#f1ece1}
 #scale-sheet.kbup.side #scale-tabs{display:none}
 #scale-panel-scale, #scale-panel-layout{display:flex; flex-direction:column; gap:var(--sp-3); min-width:0}
 #scale-panel-scale[hidden], #scale-panel-layout[hidden]{display:none}

# kills: main, footer and the deck strip are inert and aria-hidden while the settings panel is open, and restored on close
# suite: node --test --test-name-pattern main..footer.and.the.deck.strip.are.inert.and.aria.hidden.while.the.settings.panel.is.open..and.restored.on.close tests/e2e.test.js
# Drops #decks from panelBackground, so opening the settings panel leaves the
# deck strip live: not inert, not aria-hidden, and (since M2 moved the tap
# target for "+ Add a scale" into the panel) a sighted mouse user could still
# reach a deck chip behind the open panel and switch decks without closing
# it first.
# Context refreshed 2026-09-29 (M3, desktop sidebar): the line count above
# this mutation shifted (a new CSS media block and its comment). The
# mutation itself - dropping #decks from panelBackground - is byte-identical.
# Context refreshed 2026-10-16 (discoverability W1): panelBackground gained #about,
# so the removed line now carries it too; dropping #decks is still the whole mutation.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -10768,7 +10768,7 @@ const settingsScrim   = document.getElementById("settings-scrim");
 // inert the trigger along with it and the panel could never be closed by a
 // second tap on it.
 const panelBackground = [document.querySelector("main"), document.querySelector("footer"),
-                          document.getElementById("decks"), document.querySelector("#about")].filter(Boolean);
+                          document.querySelector("#about")].filter(Boolean);
 let panelOpen = false;

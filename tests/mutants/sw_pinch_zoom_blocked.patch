# kills: the card follows a held drag with a tilt, then springs back below the threshold
# suite: node --test --test-name-pattern ^card.swipe:.the.card.follows.a.held.drag.with.a.tilt,.then.springs.back.below.the.threshold$ tests/e2e.test.js
# Narrows .scene's touch-action from "pan-y pinch-zoom" to "pan-y": pinch-zoom
# is no longer explicitly allowed over the card, which a strict UA could take
# as license to intercept it for its own gesture handling.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -423,7 +423,7 @@ main{flex:1; display:flex; align-items:center; justify-content:center; width:100
    by changing Chrome's scroll-blocking heuristics for every ordinary touch,
    even when the listener itself did nothing. */
 main{touch-action:pan-y pinch-zoom}
-.scene{touch-action:pan-y pinch-zoom}
+.scene{touch-action:pan-y}
 main{overflow-x:clip}
 /* The card is sized from whichever axis runs out first.
    --card-w caps the WIDTH (88vw, 46vh, 420px), but taking it as the width and

# kills: card swipe: Enter on a focused #next after a settled touch swipe still steps
# suite: node --test --test-name-pattern ^card.swipe:.Enter.on.a.focused.#next.after.a.settled.touch.swipe.still.steps$ tests/e2e.test.js
# Inverts the waitFor condition that replaced the fixed 50ms sleep after a touch
# swipe settles: eatClick never becomes true on its own, so the wait runs to its
# timeout and the test fails instead of silently passing on a dead condition.
diff --git a/tests/e2e.test.js b/tests/e2e.test.js
--- a/tests/e2e.test.js
+++ b/tests/e2e.test.js
@@ -9255,7 +9255,7 @@ function run() {
       await b.drag("#card", [[-40, 100], [-80, 200], [-120, 300]]);
       await b.finishAnimations();
       await expectCount(`2 / ${n}`, "the touch swipe should commit and land");
-      await b.waitFor(`eatClick === false`, { label: "the touch swipe's eatClick decay" });
+      await b.waitFor(`eatClick === true`, { label: "the touch swipe's eatClick decay" });
       await b.eval(`document.getElementById("next").focus(); return true;`);
       await b.send("Input.dispatchKeyEvent", { type: "rawKeyDown", key: "Enter", code: "Enter", windowsVirtualKeyCode: 13, nativeVirtualKeyCode: 13 });
       await b.send("Input.dispatchKeyEvent", { type: "char", key: "Enter", code: "Enter", text: "\r", unmodifiedText: "\r", windowsVirtualKeyCode: 13, nativeVirtualKeyCode: 13 });

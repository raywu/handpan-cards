# kills: NO_DING shows the engine's own sentence and keeps Generate disabled
# suite: node --test --test-name-pattern ^NO_DING.shows.the.engine.s.own.sentence.and.keeps.Generate.disabled$ tests/app.test.js
# Generate stays live while the seed does not parse, so the primary action
# invites a tap that can only fail.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -12215,7 +12215,7 @@ function syncParseState({ paint }) {
     // jumps the sheet nor costs the fieldrow a second reserved line.
     paintLayout();
     scaleBox.classList.add("bad");
-    genBtn.disabled = true;
+    genBtn.disabled = false;
     if (paint) holdPanPreview();
     showRefusal(reasonText(res));
   }
diff --git a/tests/mutants/a_collision_refusal_below_the_pan.patch b/tests/mutants/a_collision_refusal_below_the_pan.patch
--- a/tests/mutants/a_collision_refusal_below_the_pan.patch
+++ b/tests/mutants/a_collision_refusal_below_the_pan.patch
@@ -10,12 +10,12 @@
 diff --git a/index.html b/index.html
 --- a/index.html
 +++ b/index.html
-@@ -8263,7 +8263,7 @@ function runGenerate() {
-     // so this composes no sentence that could pass for one and carries no code.
-     scaleBox.classList.add("bad");
-     refusal = "Another scale already has these notes.";
+@@ -12239,7 +12239,7 @@ function updateParse() {
+ function resyncSheet(paint) {
+   if (paint) cancelGesture();
+   if (refusal) {
 -    showRefusal(refusal);
 +    say(refusal, "err");
-     return;
-   }
-   if (!res.ok) {
+     if (paint) {
+       const res = HPE.core.parseSeed(String(scaleBox.value || ""), layoutOptions());
+       if (res.ok) { noteCounts(res.value.fields); paintPan(res.value, "current"); }

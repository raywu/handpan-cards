# kills: SAVE CHANGES is reachable without scrolling on a built-in-sized deck
# suite: node --test --test-name-pattern SAVE.CHANGES.is.reachable.without.scrolling.on.a.built-in-sized tests/e2e.test.js
# The sheet body refuses to shrink, so it keeps its full content height inside
# a surface capped at 85dvh, the surface scrolls again and the footer under it
# is pushed past the cap. Note this is the "it fits on MY phone" defect - the
# eight-note Edit sheet clears 390x844 and only fails on a short screen.
diff --git a/index.html b/index.html
index 574a311..dc70fca 100644
--- a/index.html
+++ b/index.html
@@ -322,7 +322,7 @@ button.nav:active{background:#2e281e}
    already 0, so overflow-y is the same declaration doing both jobs.
    .sheetsurf keeps overflow-y:auto as the backstop for the degenerate case
    where the footer alone exceeds the cap. */
-.sheetbody{overflow-y:auto; display:flex; flex-direction:column; gap:var(--sp-3)}
+.sheetbody{overflow-y:auto; flex-shrink:0; display:flex; flex-direction:column; gap:var(--sp-3)}
 /* A label, its control and the line that explains the control are ONE group:
    --sp-1 inside, and the group is separated from the next by .sheetbody. */
 .fieldrow{display:flex; flex-direction:column; gap:var(--sp-1)}

# kills: at 1280x800 and 1024x768 the panel is a static, non-modal sidebar
# suite: node --test --test-name-pattern ^at.1280x800.and.1024x768.the.panel.is.a.static..non.modal.sidebar$ tests/e2e.test.js
# Drops the one declaration that actually beats the repo's global
# [hidden]{display:none !important} rule (index.html:456) for the desktop
# sidebar. Without it, #settings-panel stays display:none at >=1024x700 -
# the sidebar never shows at all, even though the trigger/scrim are still
# correctly hidden and the rest of the media block still applies. This is
# the smallest mutation that reproduces "the breakpoint got wired up but the
# panel forgot to actually become visible".
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -465,7 +465,6 @@ a.mode{text-decoration:none}
   /* [hidden]{display:none !important} (line 456) otherwise wins over the
      rule above at equal !important weight (it has none, so this needs its
      own) - this is the one declaration that actually has to beat it. */
-  #settings-panel[hidden]{display:flex !important}
 }

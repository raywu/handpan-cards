# kills: W1 lines 1, 2 and 118: the field is a textarea that grows from one row to three, and has no sideways overflow
# suite: node --test --test-name-pattern ^W1.lines.1..2.and.118.*$ tests/e2e.test.js
# The ghost copy of the text is empty, so the field never grows past one row
# and the second and third line of a long scale sit hidden behind a scroll.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -780,7 +780,7 @@
    plus the padding and the two 1px borders; past it the textarea scrolls inside
    itself with its scrollbar hidden, so the width the text wraps at never changes. */
 #scale-box-wrap{display:grid; min-width:0; font:400 16px/1.3 Bitter, serif}
-#scale-box-wrap::after{content:attr(data-grow) " "; grid-area:1/1; visibility:hidden;
+#scale-box-wrap::after{content:" "; grid-area:1/1; visibility:hidden;
   white-space:pre-wrap; overflow-wrap:anywhere; overflow:hidden; box-sizing:border-box;
   min-height:48px; max-height:calc(3 * 1.3em + 26px); padding:12px var(--sp-3);
   border:1px solid transparent; font:inherit}

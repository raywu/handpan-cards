# kills: booting on a page route opens nothing and leaves a clean hash
# suite: node --test --test-name-pattern ^booting.on.a.page.route.opens.nothing.and.leaves.a.clean.hash$ tests/app.test.js
# The boot cleanup pushes the clean URL instead of replacing it, so the
# rejected route stays an entry behind it and the first back press returns to
# the route just refused.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -11359,7 +11359,7 @@ function syncRoute() {
   if (sheetOpen) return;
   const { route, reason } = routeInfo(deck());
   const want = location.pathname + location.search + route;
-  if (location.pathname + location.search + location.hash !== want) history.replaceState(history.state, "", want);
+  if (location.pathname + location.search + location.hash !== want) history.pushState(history.state, "", want);
   const refused = route === "";
   shareCopy.disabled = refused;
   shareCopy.title = refused ? reason : "";

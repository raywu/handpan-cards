# kills: arrow keys and Enter/Space do not reach the card while the settings panel is open
# suite: node --test --test-name-pattern ^arrow.keys.and.Enter.Space.do.not.reach.the.card.while.the.settings.panel.is.open$ tests/e2e.test.js
# Drops `el.inert = true` from openPanel()'s background-disabling loop,
# leaving only the aria-hidden attribute. #card keeps tabindex="0" and is no
# longer inert, so document.getElementById("card").focus() succeeds while the
# panel is open - the test's "#card sits inside <main> ... it must refuse
# focus" assertion reds directly (activeElement === #card).
# Context refreshed 2026-09-29 (M3, desktop sidebar): openPanel() now returns
# early at desktopMQ.matches before this loop, and the scrim/role/aria-modal
# lines that precede it moved down three lines. The mutation itself - drop
# `el.inert = true`, keep only `el.setAttribute("aria-hidden", "true")` - is
# byte-identical to before.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -7705,7 +7705,7 @@ function openPanel() {
   settingsScrim.removeAttribute("hidden");
   settingsPanel.setAttribute("role", "dialog");
   settingsPanel.setAttribute("aria-modal", "true");
-  for (const el of panelBackground) { el.inert = true; el.setAttribute("aria-hidden", "true"); }
+  for (const el of panelBackground) { el.setAttribute("aria-hidden", "true"); }
 }
 function closePanel() {
   if (!panelOpen) return;

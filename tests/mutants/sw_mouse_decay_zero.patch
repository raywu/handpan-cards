# kills: card swipe: a click more than 400ms after a committing mouse drag is not eaten and flips
# suite: node --test --test-name-pattern ^card.swipe..a.click.more.than.400ms.after.a.committing.mouse.drag.is.not.eaten.and.flips$ tests/e2e.test.js
# Q33/D180-6: drops the mouse branch of the decay ternary to 0, same as
# touch/pen, so a committing mouse release never gets its 400ms eatClick
# window at all. The test's own `eatClick` check right after `finishAnimations()`
# - before the 450ms wait - requires eatClick still true at that point; a
# zero-length decay has already fired its setTimeout(0) by then, so the
# assertion sees `false` where it expects `true`.
# Re-cut 2026-10-03 (AP1-a): release() now executes releaseDecision() and both pointerdown sites call canStartGesture(); the mutation is re-expressed on the new site, intent unchanged.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8849,7 +8849,7 @@ function release(e, cancelled, pushPoint = true) {
   const d = releaseDecision({ dx, dy: drag.lastY, vx, moved: drag.moved, cancelled,
     blocked: cancelled || panelOpen || sheetOpen, mouse, reducedMotion: reducedMotion.matches });
   drag = null;
-  if (d.eatClick) setEatClick(true, mouse ? 400 : 0);
+  if (d.eatClick) setEatClick(true, mouse ? 0 : 0);
   if (d.kind === "rest") {
     swipeRest();
     if (d.dir) step(d.dir);

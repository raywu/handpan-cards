# kills: the tier buttons are disabled and out of the Tab order in modes A and B, enabled only in S
# suite: node --test --test-name-pattern ^the.tier.buttons.are.disabled.and.out.of.the.Tab.order.in.modes.A.and.B,.enabled.only.in.S$ tests/e2e.test.js
# B2 (reviewer FAIL #3): a hidden idref still contributes its text to the
# accessible description, so aria-describedby="panel-tier-note" must come OFF
# the live mode-S buttons. Dropping the removal leaves it set unconditionally,
# so mode-S screen-reader users still hear "Pick CHORD PROGRESSION to change
# this." on buttons that already work.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8780,8 +8780,7 @@ function setMode(m) {
     // accessible description, so the attribute must come OFF while the
     // buttons are live (mode S) - otherwise mode-S screen-reader users hear
     // "Pick CHORD PROGRESSION to change this." on buttons that already work.
-    if (m === "S") tierBtn.removeAttribute("aria-describedby");
-    else tierBtn.setAttribute("aria-describedby", "panel-tier-note");
+    tierBtn.setAttribute("aria-describedby", "panel-tier-note");
   }
   document.getElementById("panel-tier-note").hidden = m === "S";
   document.getElementById("foot").classList.toggle("seq", m === "S");

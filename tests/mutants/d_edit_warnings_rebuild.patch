# kills: the Edit sheet shows deck.warnings from the registry with no generation call
# suite: node --test --test-name-pattern ^the.Edit.sheet.shows.deck.warnings.from.the.registry.with.no.generation.call$ tests/app.test.js
# The Edit page re-derives the warnings by rebuilding the deck, which gives
# them a second producer that can disagree with the one that generated it.
# Re-anchored 2026-10-13 (seeded SAVE / DELETE, lane app) against the current source. The mutation itself is unchanged.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -12505,7 +12505,8 @@ function openEditSheet(d, opener) {
   showSheet(opener);
   // [eng-review 2, 2A] warnings have ONE producer and were copied onto the deck
   // at generation time; the Edit sheet reads them and never rebuilds to re-derive.
-  const warned = (d.warnings || []).map(w => reasonText(w));
+  const again = HPE.select.build(HPE.core.parseSeed(scaleBox.value, d.options).value);
+  const warned = ((again.ok ? again.value.warnings : []) || []).map(w => reasonText(w));
   if (warned.length) { say(warned.join(" "), "warn"); msgLine.classList.add("pan"); }
 }
 /** Take the page down. The DOM half only - the route is the caller's. */

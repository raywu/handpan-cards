# kills: a same-tab #account link on a host without sign-in leaves the deck's own route in the address bar
# suite: node --test --test-name-pattern ^a.same.tab.#account.link tests/e2e_sync.test.js
# Refs TRI-28: sign-in QA fixes. On a host without sign-in the #account fragment stays in the address bar.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -19672,8 +19672,8 @@ function closeSubpage() {
 }
 function routedSubpage(name) {
   if (subpage || aboutOpen || sheetOpen) return;
-  history.replaceState(history.state, "", location.pathname + location.search + routeInfo(deck()).route);
   if (name === "account" && !syncActive()) return;
+  history.replaceState(history.state, "", location.pathname + location.search + routeInfo(deck()).route);
   openSubpage(name);
 }
 document.getElementById("account-close").onclick = closeSubpage;

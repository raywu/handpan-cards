# kills: battiloro window: a run of five or more notes outside the kept window blocks with CONFLICTING_LIST
# suite: node --test --test-name-pattern ^battiloro.window tests/import.test.js
# The whole-text scan never raises CONFLICTING_LIST, so narrowing to the window hides a run of notes outside it.
diff --git a/src/engine/importer.js b/src/engine/importer.js
--- a/src/engine/importer.js
+++ b/src/engine/importer.js
@@ -324,7 +324,7 @@ var HPE = (typeof HPE !== "undefined") ? HPE : {};
       while ((sm = sr.exec(whole))) {
         if ((sm.index < w.start || sm.index + sm[0].length > w.end) && !REFERENCE.test(whole.slice(sm.index))) strays += 1;
       }
-      if (outside) flag("CONFLICTING_LIST", { runs: outside });
+      if (false) flag("CONFLICTING_LIST", { runs: outside });
       else if (strays) flag("CONFLICTING_LIST", { notes: strays });
       base = w.start;
       original = full.slice(w.start, w.end);

# kills: the tier buttons are disabled and out of the Tab order in modes A and B, enabled only in S
# suite: node --test --test-name-pattern ^the.tier.buttons.are.disabled.and.out.of.the.Tab.order.in.modes.A.and.B,.enabled.only.in.S$ tests/e2e.test.js
# D-10: the greyed-state note ("Pick CHORD PROGRESSION to change this.") only
# makes sense while the tier buttons are disabled. Dropping this assignment
# leaves it visible (never hidden) once the panel first renders it, so it
# keeps showing in mode S where the buttons are already live.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8783,7 +8783,6 @@ function setMode(m) {
     if (m === "S") tierBtn.removeAttribute("aria-describedby");
     else tierBtn.setAttribute("aria-describedby", "panel-tier-note");
   }
-  document.getElementById("panel-tier-note").hidden = m === "S";
   document.getElementById("foot").classList.toggle("seq", m === "S");
   document.getElementById("seq-style").hidden = m !== "S";
   const shuffleBtn = document.getElementById("shuffle");

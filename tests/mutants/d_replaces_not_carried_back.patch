# kills: SD: a replacement takes the seeded slot across a reload and a field edit
# suite: node --test --test-name-pattern ^SD..a.replacement.takes.the.seeded.slot.across.a.reload.and.a.field.edit$ tests/app.test.js
# generateDeck stops carrying replaces back onto the built deck, so a field edit mints a plain custom deck that leaves the seeded slot.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -9894,7 +9894,6 @@ function buildGenerated(text, options, guard) {
   // Local replacement provenance is explicit; an inventory sibling has no
   // authority to grant it. Import commands strip it before committing.
   const replaces = options && options.replaces;
-  if (typeof replaces === "string" && isBuiltIn(replaces)) built.value.options.replaces = replaces;
   return built;
 }

     b.innerHTML='<span class="dot"></span>'+esc(labels[i]);
-    let accessible=on?t("sheet.edit_aria",{name:labels[i]}):labels[i];
+    let accessible=on?t("sheet.edit_aria",{name:d.name}):labels[i];
     if(labels[i]!==chipLabel(d.name)) {

# kills: the selected chip carries a pencil on every deck; no unselected chip does
# suite: node --test --test-name-pattern ^the.selected.chip.carries.a.pencil.on.every.deck..no.unselected.chip.does$ tests/e2e.test.js
# The accessible name goes back to the FULL deck name while the chip keeps
# rendering chipLabel(). Below CHIP_CAP the two are the same string and nothing
# moves; past it the chip reads "MY LOW PYGMY SC..." and announces "Edit MY LOW
# PYGMY SCALE", so the visible string stops being contained in the accessible
# name - WCAG 2.5.3 Label-in-Name, and Voice Control's "tap <what I can read>"
# matches nothing. This is the mutant the old /^Edit .+/ assertion could not
# catch: it passes on both spellings, which is why it was tightened to a
# substring check against a name long enough to be elided.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -10745,7 +10745,7 @@ function buildChips() {
       // and an accessible name built from the full one stops containing the
       // visible string - WCAG 2.5.3 Label-in-Name, which is what Voice
       // Control matches "tap <the words I can see>" against.
-      b.setAttribute("aria-label", t("sheet.edit_aria", { name: chipLabel(d.name) }));
+      b.setAttribute("aria-label", t("sheet.edit_aria", { name: d.name }));
     }
     // [design-review 7A] the ALREADY-SELECTED chip is the one and only way into
     // the sheet; every other chip just selects its deck. Seeded and custom decks

# kills: AF rest baseline 568x320 to 320x568 de: a banner raised at one size and carried to a stacked size holds the tab strip and name input at that size's rest
# suite: node --test --test-name-pattern AF.rest.baseline.568x320.to.320x568.de tests/editor_e2e.test.js
# fault: A raise with no rest baseline (opened in phone landscape or the 900px grid, then rotated) falls back to the row's min-height, so the tab strip and name input sit 12px above their rest and jump on clear (round-2 F1).
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -14004,8 +14004,7 @@ function editorSyncConflictRow(reset) {
   const raised = !root.classList.contains("conflict-row");
   const regionTop = editorEl("editor-region").scrollTop;
   if (raised) {
-    if (!editorRestRowAt) editorRestRowAt = editorRestRowHeight(row);
-    editorConflictRowAt = editorRestRowAt;
+    editorConflictRowAt = editorRestRowAt || row.offsetHeight;
     root.style.setProperty("--ed-conflict-region", editorEl("editor-region").offsetHeight - Math.max(0, editorConflictRowAt - row.offsetHeight) + "px");
     root.classList.add("conflict-row");
   }

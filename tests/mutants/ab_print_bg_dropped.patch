# kills: under print media, html computes to a white background
# suite: node --test --test-name-pattern ^under.print.media..html.computes.to.a.white.background$ tests/e2e.test.js
# Drops the print-block background:#fff lane A adds to html,body (eng review
# F1). Without it, a dark html background prints through the print block's
# `*{print-color-adjust:exact}` on the margins or overflow pages of a browser
# Cmd+P.
# Context-refreshed 2026-09-29 (R1): the mutated line is unchanged; the whole
# legacy print-sheet CSS block above it (#printroot, body.printing) is gone,
# so the surrounding comment and line number moved.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -872,7 +872,7 @@
 @media print{
   *{-webkit-print-color-adjust:exact; print-color-adjust:exact}
-  html,body{height:100%; min-height:0; overflow:visible; background:#fff}
+  html,body{height:100%; min-height:0; overflow:visible}
   /* The safe-area padding is an on-screen notch reservation and has no meaning
      on paper; left in, it shifts every page by the device's insets. */
   body{margin:0; padding:0; background:#fff; display:block}
 }

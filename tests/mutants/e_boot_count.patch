# kills: boots with the first deck loaded
# suite: node --test --test-name-pattern ^boots.with.the.first.deck.loaded$ tests/e2e.test.js
# Re-cut 2026-10-01 (lane AP, post-refactor triage A188-1): render() used to
# set the counter tail (classList.remove("seq") + textContent) once per
# branch, mode A and mode B each independently, because finding 18's
# mode-gated render() put each face-build and its counter update in the
# same branch. That duplication is now hoisted into a single `if (mode !==
# "S")` block after the if/else, so the line this mutant drops "+ 1" from
# exists exactly once. refresh_mutants.py could not place this patch
# because the removed line text (`index.html:6775` pre-hoist) appeared
# twice in the file and the indentation changed once hoisted, so it is
# re-cut by hand against the single hoisted line (default boot mode is A,
# so this still anchors boot's first render) - the mutation itself
# (dropping "+ 1" from the counter) is unchanged.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -7352,7 +7352,7 @@ function render() {
   }
   if (!inSeq) {
     document.getElementById("count").classList.remove("seq");
-    document.getElementById("count").textContent = `${idx + 1} / ${order.length}`;
+    document.getElementById("count").textContent = `${idx} / ${order.length}`;
   }
   const cardEl = document.getElementById("card");
   cardEl.classList.toggle("flip", flipped);

# kills: AF banner clear of pan: the conflict banner covers no pan circle at 320x568 and starts below the pan
# suite: node --test --test-name-pattern AF.banner.clear tests/editor_e2e.test.js
# fault: The conflict row height is never reserved, so the banner grows upward over the pan circles again.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -13961,7 +13961,7 @@ function editorSyncConflictRow() {
   const root = editorEl("editor");
   const status = editorEl("editor-status");
   if (!root || !status) return;
-  if (status.hasAttribute("data-conflict")) root.style.setProperty("--ed-conflict-row", status.offsetHeight + "px");
+  if (false) root.style.setProperty("--ed-conflict-row", status.offsetHeight + "px");
   else root.style.removeProperty("--ed-conflict-row");
 }
 window.addEventListener("resize", editorSyncConflictRow);

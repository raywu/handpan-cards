# kills: SO: en 568x320: the idle prompt leaves the tab labels showing and a message still covers them
# suite: node --test --test-name-pattern ^SO:.en.568x320..the.idle.prompt tests/editor_e2e.test.js
# fault: In phone landscape the idle prompt is drawn over the tab labels again.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -1093,7 +1093,6 @@ body:has(#scale-sheet:not([hidden])) #settings-trigger{visibility:hidden}
   #editor-status{position:absolute; left:0; right:-8px; top:0; bottom:auto; border-radius:8px; pointer-events:none}
   #editor-status:not([data-conflict]){max-height:none; align-items:flex-start; padding-block:1px; font-size:12px; line-height:14px}
   #scale-sheet.onepanel #editor .editor-statusrow:not(:has(#editor-status[data-conflict])){position:sticky; top:0}
-  #editor-status[data-idle]{clip-path:inset(50%)}
   #editor-status:not(:empty):not([data-kind="error"]){background:#F6F4ED}
   #editor-status:not([data-conflict]) button{position:absolute; right:0; top:50%; transform:translateY(-50%); padding-inline:6px; pointer-events:auto}
   #editor-status:not([data-conflict]):has(button){padding-right:96px; min-height:34px}

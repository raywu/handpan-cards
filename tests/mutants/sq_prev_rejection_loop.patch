# 2-chord sequence survives the exclusion step instead of being filtered
# before the length draw
# suite: node --test --test-name-pattern ^pick.never.returns.the.previous.sequence.when.another.exists$ tests/sequence.test.js
diff --git a/src/engine/sequence.js b/src/engine/sequence.js
--- a/src/engine/sequence.js
+++ b/src/engine/sequence.js
@@ -287,7 +287,7 @@ var HPE = (typeof HPE !== "undefined") ? HPE : {};
       filtered = {};
       var anyLeft = false;
       LENGTH_ORDER.forEach(function (len) {
-        filtered[len] = pools[len].filter(function (seq) { return !sameSequence(seq, prev); });
+        filtered[len] = len === 2 ? pools[len] : pools[len].filter(function (seq) { return !sameSequence(seq, prev); });
         if (filtered[len].length) anyLeft = true;
       });
       if (!anyLeft) filtered = pools;

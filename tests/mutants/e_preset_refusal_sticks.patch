# kills: an edit onto another scale's inventory preserves both chips at 380px and remains editable
# suite: node --test --test-name-pattern=^an.edit.onto.another.scale's.inventory.preserves.both.chips.at.380px.and.remains.editable$ tests/e2e.test.js
# former kills: an edit onto another deck's scale is refused at 380px and both chips stay
# fault: Superseded collision-refusal state sticks when reopening a valid converged instance and blocks normal editing.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -13182,12 +13182,13 @@ function openScaleSheet(opener) {
 // The Edit path [design-review 7A]: the SAME sheet, prefilled from the selected
 // deck, seeded or custom.
 function openEditSheet(d, opener) {
   shareUrl.setAttribute("hidden", "");
   resetSheetState(d);
   showSheet(opener);
+  if ([...savedEntries.values()].filter(view => view.deck.id === d.id).length > 1) { refusal="Another scale has these notes."; showRefusal(refusal); scaleBox.classList.add("bad"); }
   // [eng-review 2, 2A] warnings have ONE producer and were copied onto the deck
   // at generation time; the Edit sheet reads them and never rebuilds to re-derive.
   const warned = (d.warnings || []).map(w => reasonText(w));
   if (warned.length) { say(warned.join(" "), "warn"); msgLine.classList.add("pan"); }
 }

# kills: an edit onto another deck's scale is refused at 380px and both chips stay
# suite: node --test --test-name-pattern ^an.edit.onto.another.deck.s.scale.is.refused.at.380px.and.both.chips.stay$ tests/e2e.test.js
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -9961,6 +9961,7 @@ function runGenerate() {
     // section 2 code enum is closed and has no code for "that scale is taken",
     // so this composes no sentence that could pass for one and carries no code.
     scaleBox.classList.add("bad");
+    scaleBox.dataset.dead = "1";
     refusal = "Another deck already uses this scale.";
     showRefusal(refusal);
     return;
@@ -10417,7 +10418,7 @@ scaleBox.addEventListener("input", () => {
     if (typeof at === "number" && scaleBox.setSelectionRange) scaleBox.setSelectionRange(at, at);
   }
   syncGrow();
-  updateParse();
+  if (!scaleBox.dataset.dead) updateParse();
 });
 // The name is a seed option, so an unusable one is rejected by core.parseSeed
 // through the same parse line every other input goes through.

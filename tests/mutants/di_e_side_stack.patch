# kills: DI: at 844x390 the Add sheet shows the small pan beside the fields, with the group heading hidden
# Plan wording: DI: at 844x390 the Add sheet shows the pan beside the fields
# suite: node --test --test-name-pattern ^DI:.at.844x390.the.Add.sheet tests/e2e.test.js
# The stage is one column, so the pan stacks above the fields in the short landscape sheet. Re-anchored 2026-10-19 (lane P).
# Mutant di_e_side_stack.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -1051,7 +1051,7 @@ footer.seq{row-gap:var(--sp-1)}
 /* The stage: the small pan and its caption in column one, the four fields in
    column two. The column is as wide as the pan alone: the caption and hint are
    0-wide and stretch, so their text never widens it. */
-.scalestage{display:grid; grid-template-columns:auto minmax(0,1fr); gap:var(--sp-3); align-items:start}
+.scalestage{display:grid; grid-template-columns:minmax(0,1fr); gap:var(--sp-3); align-items:start}
 .scalecol{display:flex; flex-direction:column; gap:var(--sp-3); min-width:0}
 .pancol{position:sticky; top:0; z-index:2; display:flex; flex-direction:column; gap:var(--sp-1)}
 .pancol > #scale-layout-row{width:0; min-width:100%}

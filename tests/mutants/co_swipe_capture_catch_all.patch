# kills: card swipe: startDrag swallows only NotFoundError from setPointerCapture
# suite: node --test --test-name-pattern ^card.swipe:.startDrag.swallows.only.NotFoundError.from.setPointerCapture$ tests/e2e.test.js
# startDrag() reverts to a catch-all around setPointerCapture. A TypeError (or
# any non-NotFoundError) from the capture call is then swallowed instead of
# surfacing as an uncaught page exception, so the test's first half never
# sees its probe exception.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8926,7 +8926,7 @@ function startDrag(e) {
   scene.getAnimations().forEach(a => a.cancel());
   drag = { id: e.pointerId, x0: e.clientX, y0: e.clientY, last: 0, lastY: 0, moved: false, pts: [{ x: e.clientX, t: e.timeStamp }], pointerType: e.pointerType };
   // NotFoundError: a synthetic or already-released pointer id has nothing to capture.
-  try { card.setPointerCapture(e.pointerId); } catch (err) { if (err.name !== "NotFoundError") throw err; }
+  try { card.setPointerCapture(e.pointerId); } catch {}
 }
 function canStartGesture(e, state) {
   return !state.drag && e.isPrimary && e.button === 0 && !state.panelOpen && !state.sheetOpen && state.orderLength > 0;

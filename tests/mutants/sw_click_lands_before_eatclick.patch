# kills: card swipe (mouse momentum): a fast release flies on at its release speed, leaves the viewport, then the next card enters
# card swipe (mouse momentum): a fast release flies on at its release speed, leaves the viewport, then the next card enters
# suite: node --test --test-name-pattern ^card.swipe.\(mouse.momentum\):.a.fast.release.flies.on.at.its.release.speed,.leaves.the.viewport,.then.the.next.card.enters$ tests/e2e.test.js
# Restores the pre-D180-7 ordering (docs/plans/2026-10-01-swipe-momentum.md,
# decision 4): land() unconditionally, THEN check eatClick. A mouse release
# that commits a drag fires its own trailing click on the same task; with
# land() called first, that click kills the fly-out flight before it has
# played at its release speed at all, so the flight is never alive and never
# reaches a finishedAt - the original D180-7 bug this lane exists to fix.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8444,8 +8444,8 @@ document.addEventListener("click", e => {
   // animation on that very click, before it ever had a chance to play at
   // its release speed. A click that didn't come from a drag (eatClick
   // false) still lands a live flight, same as before.
-  if (eatClick) { setEatClick(false); e.stopPropagation(); e.preventDefault(); return; }
   land();
+  if (eatClick) { setEatClick(false); e.stopPropagation(); e.preventDefault(); }
 }, true);


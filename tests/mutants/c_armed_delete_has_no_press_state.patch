# kills: the armed delete button still answers a press, in the pressed colour
# suite: node --test --test-name-pattern ^the.armed.delete.button.still.answers.a.press..in.the.pressed.colour$ tests/e2e.test.js
# The armed rule keeps its amber under the thumb, because it has the same
# specificity as the shared :active rule and comes later in the file. The tap
# that destroys the deck becomes the only press on the page with no answer.
# Context-refreshed 2026-09-29 (R1): the mutated line is unchanged; the print
# block's comment header below it was reworded when the legacy print-sheet
# CSS was deleted, moving this from :731 to :858.
# Context-refreshed 2026-09-30 (N2): the Q3 stale-comment fix reworded the
# print-block header comment again (it no longer opens with "This block is
# deliberately LAST in the <style> element. It redefines"), so the hunk's
# trailing context line and line number were updated to match; the mutated
# line itself is unchanged.
# Retargeted at the field-guide rule 2026-11-03: the armed delete has no pressed colour on the light sheet.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -1453,7 +1453,6 @@ html.about-open{overflow:hidden}
 #scale-sheet #scale-layout-state, #scale-sheet #scale-field-msg, #scale-sheet #scale-neotone-extra,
 #scale-sheet #scale-del-note, #scale-sheet #scale-fields.stale #scale-fields-note,
 #scale-sheet #scale-delete[data-armed]{color:#242424}
-#scale-sheet #scale-delete[data-armed]:active{color:#5A49A6}
 #scale-sheet #scale-fields.stale input, #scale-sheet #scale-box.stale{text-decoration-color:#8A847B}
 
 #scale-sheet #scale-tabs{border-bottom-color:#8A847B}

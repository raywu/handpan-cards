# suite: node --test --test-name-pattern ^SV..this.app.writes.wire.version.6.and.keeps.records.at.4$ tests/share.test.js
# The record version follows the wire version, so every stored id moves.
diff --git a/src/engine/share.js b/src/engine/share.js
--- a/src/engine/share.js
+++ b/src/engine/share.js
@@ -83,7 +83,7 @@
   var VERSION = 6;
   // What a stored record carries. Records keep the v4 shape (formatSeed plus
   // options), so the wire version moves alone.
-  var RECORD_VERSION = 4;
+  var RECORD_VERSION = VERSION;
   // Neotone profiles (ENGINE-SPEC 18) travel at wire v7 and are stored as

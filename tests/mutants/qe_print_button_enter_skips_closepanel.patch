# kills: Enter on a print button runs its real click handler and does not flip the card
# suite: node --test --test-name-pattern ^Enter.on.a.print.button.runs.its.real.click.handler.and.does.not.flip.the.card$ tests/e2e.test.js
# Drops closePanel() from the DOWNLOAD PDF button's onclick, so activating it
# (by Enter, same as by mouse) never closes the settings panel - the kind of
# wiring break finding 9 (quality refactor 2026-09-30) needed a non-vacuous
# test to catch.
# Re-cut 2026-10-08 (lane PM): the one print button is DOWNLOAD PDF. The mutation itself is unchanged.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -1382,7 +1382,7 @@ footer.seq{row-gap:var(--sp-1)}
   <div class="panel-group">
     <h3 class="panel-heading">Print this deck</h3>
     <div class="prints">
-      <button type="button" id="print-download" onclick="downloadDeckPDF('shop', this); closePanel();">DOWNLOAD PDF</button>
+      <button type="button" id="print-download" onclick="downloadDeckPDF('shop', this);">DOWNLOAD PDF</button>
       <!-- The paper choice keeps the panel open (design direction, "After an
            action"): the next tap is a print button, not a new task. -->
       <select id="print-paper-select" aria-label="Paper size" onchange="setPrintPaper(this.value)">

# kills: switching to mode S keeps the header and footer width fixed and grows the footer only by the style block
# suite: node --test --test-name-pattern ^switching.to.mode.S.keeps.the.header.and.footer.width.fixed.and.grows.the.footer.only.by.the.style.block$ tests/e2e.test.js
# Lane S2, D8/E3. Drops the whole max-height:520px footer.seq override, so
# landscape S falls back to portrait's full-width style row under the
# controls - well past the tight landscape budget this breakpoint exists for.
# Refreshed 2026-09-30 (integrator takeover): the override is now D8's
# four-column grid, not the absolutely positioned style line.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -557,14 +557,6 @@ footer.seq{row-gap:var(--sp-1)}
    The arrows and the refresh button span both rows and stay on one centre
    line; the style line sits under the rail inside the footer box, so it never
    reaches the .announce row below it. */
-@media (max-height:520px){
-  footer.seq{grid-template-columns:56px 1fr 56px 56px; row-gap:0}
-  footer.seq #prev{grid-area:1/1/3/2}
-  footer.seq .count.seq{grid-area:1/2}
-  footer.seq .seq-style{grid-area:2/2; font-size:11.5px; line-height:1.35}
-  footer.seq #shuffle{grid-area:1/3/3/4}
-  footer.seq #next{grid-area:1/4/3/5}
-}

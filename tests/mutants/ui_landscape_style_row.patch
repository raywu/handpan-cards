# kills: switching to mode S keeps the header and footer width fixed and grows the footer only by the style block
# suite: node --test --test-name-pattern ^switching.to.mode.S.keeps.the.header.and.footer.width.fixed.and.grows.the.footer.only.by.the.style.block$ tests/e2e.test.js
# Lane S2, D8/E3. The `@media (max-height:520px)` override is meant to
# TIGHTEN the style row for landscape's tighter budget; this swaps its two
# values for larger ones (as if the desktop step-up ramp had been pasted in
# by mistake), so landscape grows the footer well past its 40px budget.
diff --git a/index.html b/index.html
index e4c1bf6..a19ab96 100644
--- a/index.html
+++ b/index.html
@@ -551,8 +551,8 @@ footer.seq{row-gap:var(--sp-1)}
    rest of the chrome already uses, rather than reserving its portrait-sized
    line height on a screen with no room for it. */
 @media (max-height:520px){
-  footer.seq{row-gap:0}
-  .seq-style{font-size:11px; line-height:1.25}
+  footer.seq{row-gap:var(--sp-3)}
+  .seq-style{font-size:14px; line-height:1.6}
 }
 /* Was 95.2 x 11.5 - the smallest interactive target in the app, and the one
    that toggles a mode the user must be able to turn OFF. Same reasoning as

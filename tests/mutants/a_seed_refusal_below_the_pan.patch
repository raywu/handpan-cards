# kills: the seed refusal sits above the pan
# suite: node --test --test-name-pattern ^the.seed.refusal.sits.above.the.pan$ tests/e2e.test.js
# #scale-refusal put where #scale-msg used to be before 2026-09-21: out of
# .fieldrow and below the preview. The text, the tier classes and aria-live are
# untouched, so every other assertion on this element still passes - which is
# the point. Only a geometric test sees it, and what the owner saw on the
# device was exactly this: the refusal below the fold with the keyboard up.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -1203,7 +1203,6 @@
            true rather than hoping every caller happens to agree. It carries
            its own aria-live because #scale-sheet is aria-modal, which puts
            the page-level .announce outside the dialog and out of reach. -->
-      <div id="scale-refusal" aria-live="polite"></div>
     </div>
     <!-- The pan mock: where the notes actually land - ding, rim zig-zag, inner
          pair, dashed bottom ring in x-ray view - drawn by the SAME pan()
@@ -1219,6 +1218,7 @@
         <div id="scale-preview" role="img"
              aria-label="Preview of where the notes sit on the pan" hidden></div>
         <div id="scale-drawer-status" aria-live="polite" aria-atomic="true" hidden></div>
+      <div id="scale-refusal" aria-live="polite"></div>
       </div>

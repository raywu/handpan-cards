# kills: an ordinary tap in the sheet says nothing, so it cannot wipe what was said
# suite: node --test --test-name-pattern ^an.ordinary.tap.in.the.sheet.says.nothing..so.it.cannot.wipe.what.was.said$ tests/app.test.js
# The early return goes away, so disarmDelete says "" on every pointerdown in
# the sheet - touching the seed field blanks the parse line that explains why
# the box is red and Generate is dead.
diff --git a/index.html b/index.html
index 93dabcf..866adc1 100644
--- a/index.html
+++ b/index.html
@@ -4875,7 +4875,6 @@ function disarmDelete() {
   /* Nothing to undo when nothing is armed, and saying so would be worse than
      silent: this runs on every pointerdown in the sheet, so an unguarded
      say("") would wipe whatever the parse line or a save had just announced. */
-  if (!delArmed) return;
   delArmed = false;
   delBtn.textContent = DEL_IDLE;
   delBtn.removeAttribute("data-armed");

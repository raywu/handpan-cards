# kills: an unparseable seed holds the last pan but stops it claiming to be current
# suite: node --test --test-name-pattern ^an.unparseable.seed.holds.the.last.pan.but.stops.it.claiming.to.be.current$ tests/preview.test.js
# A held or example pan keeps the live name and the live treatment, so the
# mock claims to show a layout the box no longer describes - the exact way a
# preview lies, now that the plate never leaves the flow.
# Refreshed 2026-10-08 (DR2a): re-anchored on the DR2a source
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -9403,13 +9403,13 @@ function clearPanPreview() {
 let panState = "example";
 function markPan(state, interactive) {
   panState = state;
-  previewBox.classList.toggle("stale", state !== "current");
+  previewBox.classList.remove("stale");
   if (interactive) {
     previewBox.setAttribute("role", "group");
     previewBox.setAttribute("aria-label", countsLabel(ringSizes(lastSolved.fields)));
   } else {
     previewBox.setAttribute("role", "img");
-    previewBox.setAttribute("aria-label", PAN_NAMES[state]);
+    previewBox.setAttribute("aria-label", PAN_NAMES.current);
   }
 }
 

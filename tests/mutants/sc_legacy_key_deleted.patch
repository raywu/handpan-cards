# kills: the legacy copy deletes the old list it only reads
# suite: node --test --test-name-pattern ^SC.an.absent.store.is.created.by.the.legacy.copy..and.a.present-but-unreadable.one.is.not$ tests/storage_corpus.test.js
# copyLegacyScales reads hpfc.scales and never writes or deletes it, so an older
# app on the same origin keeps its list. Deleting it strands that older app.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -10014,7 +10014,7 @@ function copyLegacyScales() {
   try { have = localStorage.getItem(SCALES_KEY); } catch (e) { return; }
   if (have !== null) return;
   const old = readStore(LEGACY_SCALES_KEY);
-  if (Array.isArray(old)) writeScales(old);
+  if (Array.isArray(old)) { writeScales(old); try { localStorage.removeItem(LEGACY_SCALES_KEY); } catch (e) {} }
 }
 // Queue row 132: an EXISTING record is rewritten AT ITS INDEX, and only a
 // genuinely new one is appended. restoreScales rebuilds the registry in list

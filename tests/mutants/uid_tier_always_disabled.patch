# kills: the tier buttons are disabled and out of the Tab order in modes A and B, enabled only in S
# suite: node --test --test-name-pattern ^the.tier.buttons.are.disabled.and.out.of.the.Tab.order.in.modes.A.and.B,.enabled.only.in.S$ tests/e2e.test.js
# D-10: setMode() stops re-enabling the tier buttons in mode S, so they stay
# disabled (and out of the Tab trap) forever, even in CHORD PROGRESSION mode.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8569,7 +8569,7 @@ function setMode(m) {
   // else. The remembered tier's .on/aria-pressed state is untouched by a mode
   // switch, so switching back to S shows the same choice as before.
   for (const id of ["tier-basic", "tier-intermediate", "tier-advanced"]) {
-    document.getElementById(id).disabled = m !== "S";
+    document.getElementById(id).disabled = true;
   }
   document.getElementById("panel-tier-note").hidden = m === "S";
   document.getElementById("foot").classList.toggle("seq", m === "S");

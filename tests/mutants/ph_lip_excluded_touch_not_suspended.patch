# An untracked touch (second finger, lip start, vetoed gesture) no longer suspends the scroll path: lipTouching is not read and lipDragStop sets lipDragEnd only for a tracked drag.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -12121,7 +12121,7 @@ function lipFlingStep(now) {
 function lipScrollEvent() {
   const now = Date.now();
   if (lipFling && now >= lipFling.until) lipFling = null;
-  if (lipDrag || lipTouching) { userWindowUntil = 0; lipAcc = 0; lipScroll(); return; }
+  if (lipDrag) { userWindowUntil = 0; lipAcc = 0; lipScroll(); return; }
   if (lipFling) { userWindowUntil = 0; lipAcc = 0; lipFlingStep(now); lipScroll(); return; }
   if (now < lipDragEnd) { lipDragEnd = now + LIP_END_MS; userWindowUntil = 0; lipAcc = 0; }
   lipScroll();
@@ -12188,7 +12188,7 @@ const lipDragStop = (e) => {
     const seed = L.lastMoveWay === "up" ? Math.max(0, t - L.bodyTop0) : Math.max(0, L.bodyTop0 - t);
     lipFling = { way: L.lastMoveWay, done: false, acc: seed, prevT: t, prevM: lipRange(), until: Date.now() + LIP_END_MS };
   }
-  lipDragEnd = Date.now() + LIP_END_MS;
+  if (lipDrag) lipDragEnd = Date.now() + LIP_END_MS;
   lipDrag = null;
   lipParked = null;
   lipTouching = !!(e && e.touches && e.touches.length);

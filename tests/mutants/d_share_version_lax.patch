# kills: the share version guard rejects a newer payload with NEEDS_NEWER_APP
# The Phase 4 guard accepts one version above the running app, so a PWA-cached
# old index.html would misread a newer link instead of rejecting it.
diff --git a/index.html b/index.html
index d2aeb5a..1c22c6a 100644
--- a/index.html
+++ b/index.html
@@ -2009,7 +2009,7 @@ function generateDeck(text, options) {
 // instead of misreading it (ENGINE-SPEC section 14).
 const SHARE_VERSION = 1;
 function checkShareVersion(v) {
-  return v > SHARE_VERSION
+  return v > SHARE_VERSION + 1
     ? { ok: false, code: "NEEDS_NEWER_APP", reason: HPE.core.REASONS.NEEDS_NEWER_APP.reason }
     : { ok: true, value: v };
 }

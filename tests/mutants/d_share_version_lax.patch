# kills: the share version guard rejects a newer payload with NEEDS_NEWER_APP
# suite: node --test --test-name-pattern ^the.share.version.guard.rejects.a.newer.payload.with.NEEDS_NEWER_APP$ tests/app.test.js
# The Phase 4 guard accepts one version above the running app, so a PWA-cached
# old index.html would misread a newer link instead of rejecting it.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -11627,13 +11627,13 @@ const engineErr = code => ({ ok: false, code, reason: HPE.core.REASONS[code].rea
 // section 2 enum is closed and BAD_NOTE is its rejection for malformed input.
 function checkShareVersion(v) {
   if (typeof v !== "number" || !isFinite(v)) {
     return { ok: false, code: "BAD_NOTE",
              reason: HPE.core.REASONS.BAD_NOTE.reason.split("<X>").join(String(v).slice(0, 12)) };
   }
-  return v > newestRecordVersion() ? engineErr("NEEDS_NEWER_APP") : { ok: true, value: v };
+  return v > newestRecordVersion() + 1 ? engineErr("NEEDS_NEWER_APP") : { ok: true, value: v };
 }
 
 // D14: what travels is the SEED, never the generated deck, so an old link
 // renders NEW cards once the engine improves.
 const seedOf = d => ({ fields: d.fields, options: d.options });
 const SHARE_PREFIX = "#s=";

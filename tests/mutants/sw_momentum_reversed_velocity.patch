# kills: outTiming: a velocity against the flight direction counts as zero
# suite: node --test --test-name-pattern ^outTiming..a.velocity.against.the.flight.direction.counts.as.zero$ tests/swipe.test.js
# swipeOutTiming: a velocity against the flight direction counts as zero
# Replaces the signed -dir * vx projection with Math.abs(vx)
# (docs/plans/2026-10-01-swipe-momentum.md, decision 2). A velocity pointed
# back up the drag (opposite the committed flight direction) then still
# contributes its full magnitude instead of being floored to the minimum
# speed, so a card can be seeded with a release speed in the wrong direction.
# Re-anchored to src/engine/swipe.js (App UX P1); the unit case in tests/swipe.test.js kills it.
diff --git a/src/engine/swipe.js b/src/engine/swipe.js
--- a/src/engine/swipe.js
+++ b/src/engine/swipe.js
@@ -14,7 +14,7 @@ HPE.swipe = (function () {
     return Math.abs(dx) > SWIPE_COMMIT_PX || fling ? (dx < 0 ? 1 : -1) : 0;
   }
   function swipeOutTiming(vx, dir, dx, dist) {
-    const v = Math.max(-dir * vx, SWIPE_MOMENTUM_FLOOR_PX_MS);
+    const v = Math.max(Math.abs(vx), SWIPE_MOMENTUM_FLOOR_PX_MS);
     const end = Math.max(dist, Math.abs(dx) + SWIPE_MOMENTUM_FLOOR_PX_MS * SWIPE_MOMENTUM_MIN_MS);
     const d = end - Math.abs(dx);
     const duration = Math.min(SWIPE_MOMENTUM_MAX_MS, Math.max(SWIPE_MOMENTUM_MIN_MS, d / v));

# kills: Escape closes the sheet without keeping the previewed correction
# suite: node --test --test-name-pattern ^Escape.closes.the.sheet.without.keeping.the.previewed.correction$ tests/app.test.js
# An abandoned preview is left on the deck, so Escape commits the very
# correction the user backed out of.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -4440,7 +4440,7 @@
   if (sheetSurf) sheetSurf.style.transform = "";
   // Escape and the backdrop are "without saving", and the preview was painted
   // on the real deck, so it has to come back off.
-  restoreLayoutPreview();
+  dropLayoutPreview();
   editingId = null;
   for (const el of background) { el.inert = false; el.removeAttribute("aria-hidden"); }
   (sheetOpener || addChip).focus();

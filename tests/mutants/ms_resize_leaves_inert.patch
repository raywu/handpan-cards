# kills: resizing across the breakpoint with the panel open sheds modal state, and resizing back shows the closed hamburger
# suite: node --test --test-name-pattern resizing.across.the.breakpoint.with.the.panel.open.sheds.modal.state..and.resizing.back.shows.the.closed.hamburger tests/e2e.test.js
# Context refreshed 2026-09-29 (M3, desktop sidebar, N4): the change handler
# now also re-homes focus onto #card when closePanel()'s own
# settingsTrigger.focus() silently no-ops at this width, so the block this
# mutant removes grew from one line to a small function body. The mutation
# itself is unchanged: removing the desktopMQ.addEventListener("change", ...)
# block entirely. Without it, opening the panel below the breakpoint and
# then resizing past 1024x700 leaves role="dialog"/aria-modal/inert/
# aria-hidden all still applied even though the trigger and scrim have gone
# display:none - the background is stuck inert with no way for the user to
# reach it, and no way to close the panel either (the trigger that would
# call closePanel() is no longer clickable).
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -7749,23 +7749,6 @@
   for (const el of panelBackground) { el.inert = false; el.removeAttribute("aria-hidden"); }
   settingsTrigger.focus();
 }
-// If the viewport crosses the breakpoint while the panel is open in its
-// modal, below-breakpoint presentation, shed the modal state so the page
-// underneath is never left inert on desktop (and the reverse: if it then
-// crosses back down, the panel is the closed hamburger state, not a
-// borderless leftover). The panel itself stays in the DOM either way; only
-// its modal wiring and `hidden` (irrelevant at desktop - see the CSS
-// override above) change.
-desktopMQ.addEventListener("change", (e) => {
-  if (e.matches && panelOpen) {
-    closePanel();
-    // Reviewer finding N4: closePanel()'s own settingsTrigger.focus() call is
-    // a silent no-op here - the trigger is display:none at this width once
-    // the CSS has already flipped - so with nothing else to catch it focus
-    // fell to <body>. Re-home it on the card, which is always live.
-    if (document.activeElement === document.body || !document.activeElement) card.focus();
-  }
-});
 settingsTrigger.addEventListener("click", () => { if (panelOpen) closePanel(); else openPanel(); });
 settingsScrim.addEventListener("click", closePanel);
 document.getElementById("print-paper-select").value = printPaper;

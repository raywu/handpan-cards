# kills: render() with an emptied order does not throw and leaves the last card on screen
# suite: node --test --test-name-pattern ^render\(\).with.an.emptied.order.does.not.throw.and.leaves.the.last.card.on.screen$ tests/app.test.js
# Drops the empty-order guard CLAUDE.md's "Known pitfalls" says to keep.
# With no guard, order[idx] is undefined on an empty order and d.chords[undefined]
# is undefined too, so ch.fields inside linesHTML/pan throws a TypeError instead
# of render() quietly doing nothing.
# Refreshed 2026-09-29 (lane S2): render() gained a new mode==="S"-empty-sequence
# guard ABOVE this line (renders renderSeqEmpty() instead, E3); the targeted
# `if (!order.length) return;` line for modes A/B is otherwise unchanged, only
# the line number moved.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -7310,7 +7310,6 @@ function faceHTML(d, ch, n, kind) {
 function render() {
   const inSeq = mode === "S";
   if (inSeq && (!seq || !seq.chords)) { renderSeqEmpty(); return; }
-  if (!order.length) return;
   const d = deck(), n = order[idx] + 1, ch = d.chords[order[idx]];
   document.documentElement.style.setProperty("--root", d.colors.root);
   document.documentElement.style.setProperty("--tone", d.colors.tone);

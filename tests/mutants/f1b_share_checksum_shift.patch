# kills: the v4 reader's checksum is pinned against a captured minimal link (Q18)
# suite: node --test --test-name-pattern ^the.v4.reader.s.checksum.is.pinned.against.a.captured.minimal.link..Q18.$ tests/share.test.js
# checksum's FNV-1a mixing shifts the high half by 15 bits instead of 16,
# changing every checksum's value while leaving encode/decode self-consistent
# (a round trip alone never notices). Any share link generated by this build
# fails to decode on any other build, and vice versa.
diff --git a/src/engine/core.js b/src/engine/core.js
--- a/src/engine/core.js
+++ b/src/engine/core.js
@@ -971,7 +971,7 @@ var HPE = (typeof HPE !== "undefined") ? HPE : {};
       hash = (hash ^ bytes[i]) >>> 0;
       // 32-bit multiply by 0x01000193 without losing precision.
       hash = (((hash & 0xffff) * 0x01000193) +
-              ((((hash >>> 16) * 0x01000193) & 0xffff) << 16)) >>> 0;
+              ((((hash >>> 16) * 0x01000193) & 0xffff) << 15)) >>> 0;
     }
     return hash;
   }

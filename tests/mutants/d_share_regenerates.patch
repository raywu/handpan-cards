# kills: consuming a share link runs select.build exactly once
# suite: node --test --test-name-pattern ^consuming.a.share.link.runs.select.build.exactly.once$ tests/app.test.js
# Consuming a link builds the deck twice - the shape a rebuild-per-read would
# have. ENGINE-SPEC section 11: generation runs ONCE per restore.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -9851,6 +9851,7 @@ function openShare(text) {
   const res = HPE.share.decode(String(text));
   if (!res.ok) { say(reasonText(res), "err"); return res; }
   // Generation runs ONCE per restore, here, exactly as submit does (section 11).
+  generateDeck(HPE.core.formatSeed(res.value.fields), res.value.options);
   const built = generateDeck(HPE.core.formatSeed(res.value.fields), res.value.options);
   if (!built.ok) { say(reasonText(built), "err"); return built; }
   rememberScale(seedOf(built.value));
diff --git a/tests/mutants/a_collision_refusal_below_the_pan.patch b/tests/mutants/a_collision_refusal_below_the_pan.patch
--- a/tests/mutants/a_collision_refusal_below_the_pan.patch
+++ b/tests/mutants/a_collision_refusal_below_the_pan.patch
@@ -10,12 +10,12 @@
 diff --git a/index.html b/index.html
 --- a/index.html
 +++ b/index.html
-@@ -8263,7 +8263,7 @@ function runGenerate() {
-     // so this composes no sentence that could pass for one and carries no code.
-     scaleBox.classList.add("bad");
-     refusal = "Another scale already has these notes.";
+@@ -12239,7 +12239,7 @@ function updateParse() {
+ function resyncSheet(paint) {
+   if (paint) cancelGesture();
+   if (refusal) {
 -    showRefusal(refusal);
 +    say(refusal, "err");
-     return;
-   }
-   if (!res.ok) {
+     if (paint) {
+       const res = HPE.core.parseSeed(String(scaleBox.value || ""), layoutOptions());
+       if (res.ok) { noteCounts(res.value.fields); paintPan(res.value, "current"); }

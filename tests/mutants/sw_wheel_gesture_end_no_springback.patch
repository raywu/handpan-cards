# kills: card swipe (wheel): deltaX under 80px does nothing and leaves no transform
# suite: node --test --test-name-pattern ^card.swipe..wheel...deltaX.under.80px.does.nothing.and.leaves.no.transform$ tests/e2e.test.js
# Drops the springBack(w.sx) call in wheelGestureEnd: a sub-threshold
# wheel gesture that never committed leaves the scene's follow transform
# and willChange hint in place forever instead of settling back to rest.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8239,7 +8239,6 @@ function wheelGestureEnd() {
   wheel = null;
   if (w.skip || w.fired) return;
   if (reducedMotion.matches) { swipeRest(); return; }
-  springBack(w.sx);
 }
 wheelMain.addEventListener("wheel", e => {
   if (e.ctrlKey) return; // pinch-zoom, not a swipe gesture

# kills: swipe core: outTiming: a slow or zero-velocity release starts at the floor and clamps at MOMENTUM_MAX_MS
# suite: node --test --test-name-pattern ^outTiming..a.slow.or.zero-velocity.release.starts.at.the.floor.and.clamps.at.MOMENTUM_MAX_MS$ tests/swipe.test.js
# swipeOutTiming: a slow or zero-velocity release starts at the floor and clamps at SWIPE_MOMENTUM_MAX_MS
# Replaces SWIPE_MOMENTUM_FLOOR_PX_MS with 0 in swipeOutTiming's speed floor
# (docs/plans/2026-10-01-swipe-momentum.md, decision 2). A zero-velocity
# release then starts the easing curve at literal 0 px/ms instead of the
# plan's 1.5 px/ms floor - the card restarts from a standstill, exactly the
# D180-7 symptom this lane exists to fix.
# Re-anchored to src/engine/swipe.js (App UX P1); the unit case in tests/swipe.test.js kills it.
diff --git a/src/engine/swipe.js b/src/engine/swipe.js
--- a/src/engine/swipe.js
+++ b/src/engine/swipe.js
@@ -14,7 +14,7 @@ HPE.swipe = (function () {
     return Math.abs(dx) > SWIPE_COMMIT_PX || fling ? (dx < 0 ? 1 : -1) : 0;
   }
   function swipeOutTiming(vx, dir, dx, dist) {
-    const v = Math.max(-dir * vx, SWIPE_MOMENTUM_FLOOR_PX_MS);
+    const v = Math.max(-dir * vx, 0);
     const end = Math.max(dist, Math.abs(dx) + SWIPE_MOMENTUM_FLOOR_PX_MS * SWIPE_MOMENTUM_MIN_MS);
     const d = end - Math.abs(dx);
     const duration = Math.min(SWIPE_MOMENTUM_MAX_MS, Math.max(SWIPE_MOMENTUM_MIN_MS, d / v));

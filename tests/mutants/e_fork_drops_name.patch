# kills: saving Pygmy with a palette change at 380px replaces its chip in place with the Pygmy name
# suite: node --test --test-name-pattern ^saving.Pygmy.with.a.palette.change.at.380px.replaces.its.chip.in.place.with.the.Pygmy.name$ tests/e2e.test.js
# The seeded SAVE sheet prefills a mangled name, so the replacement is not saved under the Pygmy name.
# (A blank name is no longer a mutation: Pygmy's generated name equals its seed name in a browser.)
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -13293,7 +13293,7 @@ function resetSheetState(edit, target = selection) {
   // Everything else starts as a new scale would: mirror off.
   const o = !edit ? null : seeded()
     ? { anchor: edit.fields["1"] && edit.fields["1"][4] !== 270 ? "between" : "one" } : edit.options;
-  nameBox.value = edit ? edit.name : "";
+  nameBox.value = edit ? edit.name.replace(/\d/g, "") : "";
   nameDirty = false;                                 // prefilled, not typed
   // The line lists the top notes in seat order (Q4 A), so a record with seats
   // reads as it was typed; a seeded deck or a record without seats is the

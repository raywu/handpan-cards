   #editor #editor-status{position:relative!important;inset:auto!important;min-height:0;padding:0;margin:0;width:100%;pointer-events:none}
   #editor #editor-status:not(:empty){padding:6px 8px 8px;box-sizing:border-box;background:#242424;color:#F6F4ED;border-radius:12px;box-shadow:0 5px 16px #0003;line-height:1.3}

# kills: a hairline divides the pinned footer from the scroll, so the footer reads as fixed
# suite: node --test --test-name-pattern ^a.hairline.divides.the.pinned.footer.from.the.scroll..so.the.footer.reads.as.fixed$ tests/e2e.test.js
# The scrollport's bottom edge draws no rule, so the pinned footer floats with
# nothing to say it does not move. This is the regression the `.sheetsurf >
# .ctlrow` selector shipped once already, silently.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -939,7 +939,7 @@ footer.seq{row-gap:var(--sp-1)}
    the file's only border-top. The boundary it describes is .sheetbody's own
    edge, so that is where it belongs: moving a child across it cannot unhook it
    again. Pinned by "a hairline divides the pinned footer from the scroll". */
-.sheetbody{border-bottom:1px solid #3a352d}
+.sheetbody{}
 /* The pinned message slot between the scrollport and the primary. It reserves
    nothing: with no visible message it is out of flow and 0px tall with no
    margins (owner 2026-10-20), and it grows only to the height of the text it

# kills: SD: a seed both hidden and replaced boots onto its replacement without a warning
# suite: node --test --test-name-pattern ^SD..a.seed.both.hidden.and.replaced.boots.onto.its.replacement.without.a.warning$ tests/app.test.js
# The boot guard forgets that landing on a seed's replacement is not a lost deck, so a hidden, replaced seed says "That deck is gone." while showing its own replacement.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -14239,8 +14239,7 @@ if (routedDeck && routedDeck !== bootStored) track("deck_route", { deck_id: rout
 // renamed deck and falls back SILENTLY, as it always has. A missing custom: id
 // means the user's own saved scale is gone - deleted, or dropped as corrupt -
 // and a silent switch would look like the app lost their deck, so say so.
-if (wantedDeck !== deckId && !(replacements()[wantedDeck] && replacements()[wantedDeck].id === deckId) &&
-    (wantedDeck.indexOf("custom:") === 0 || hidden.includes(wantedDeck)))
+if (wantedDeck !== deckId && (wantedDeck.indexOf("custom:") === 0 || hidden.includes(wantedDeck)))
   say(t("boot.gone", { name: deck().name }), "warn");
 // A page route in the address bar at boot is a RELOAD of a page, or a link
 // someone pasted. Neither reopens it: #edit-<id> names a deck this session may

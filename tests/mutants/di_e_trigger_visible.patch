# kills: DI: the settings trigger is neither visible nor hit-testable while the scale sheet is open
# suite: node --test --test-name-pattern ^DI:.the.settings.trigger.is.neither tests/e2e.test.js
# Mutant di_e_trigger_visible.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -1254,7 +1254,7 @@ footer.seq{row-gap:var(--sp-1)}
 /* The scroller spans the screen, so a swipe on the flanks beside the 520px column scrolls it too. */
 #scale-sheet.tiny .sheetsurf{max-width:none; padding-inline:max(var(--sp-3), calc((100% - 520px) / 2 + var(--sp-3)))}
 /* The app's settings trigger paints over the open sheet; it has no job there. */
-body:has(#scale-sheet:not([hidden])) #settings-trigger{visibility:hidden}
+body:has(#scale-sheet:not([hidden])) #settings-trigger{visibility:visible}
 /* The one-panel editor (flag on): #editor is built by editorOpen() and sits beside
    the legacy surface, which is hidden while it is up. Phone first: one column,
    nothing scrolls; from 900px the pan takes the left and the controls the right. */

# kills: OQA tablet portrait stacks: at 820x1180 and 1024x1366 the controls sit under the pan, the pan fills the column, nothing scrolls sideways
# suite: node --test --test-name-pattern ^OQA.tablet.portrait tests/editor_e2e.test.js
# fault: A portrait tablet gets the two-column grid.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -1408,7 +1408,7 @@ body:has(#scale-sheet:not([hidden])) #settings-trigger{visibility:hidden}
    the two-column grid is for landscape only; a portrait tablet stacks at phone width.
    The control rows sit between two spacer rows, so they centre on the pan, which
    spans every row under the head. */
-@media (min-width:900px) and (orientation:landscape){
+@media (min-width:900px){
   #scale-sheet.onepanel #editor{max-width:1100px; padding:var(--sp-4); gap:var(--sp-3) var(--sp-4); display:grid;
     grid-template-columns:minmax(0,1.3fr) minmax(320px,1fr); grid-template-rows:auto 1fr auto auto auto auto auto auto 1fr;
     grid-template-areas:"head head" "pan ." "pan line" "pan status" "pan counts" "pan tabs" "pan panel" "pan bar" "pan ."}

# kills: every button and link in the settings panel centres its label, line by line; the paper select asks for a centred value
# suite: node --test --test-name-pattern every.button.and.link.in.the.settings.panel.centres.its.label tests/e2e.test.js
# menu-resources AD8. Drops text-align / text-align-last from the print controls, so the paper select shows LETTER start-aligned.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -557,7 +557,6 @@ main{overflow-x:clip}
   white-space:nowrap; -webkit-appearance:none; appearance:none}
 .prints button, .prints select{flex:1 1 auto}
 .prints #print-download{flex:3 1 auto; padding-left:6px; padding-right:6px}
-.prints button, .prints select{text-align:center; text-align-last:center}
 .prints button:hover, .prints button:focus-visible,
 .prints select:hover, .prints select:focus-visible{background:#2a251c}
 .prints button:active, .prints select:active{color:#f1ece1}

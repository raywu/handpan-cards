# kills: card swipe (wheel): the axis lock holds for the whole gesture even once later deltas favour the other axis
# suite: node --test --test-name-pattern ^card.swipe..wheel...the.axis.lock.holds.for.the.whole.gesture.even.once.later.deltas.favour.the.other.axis$ tests/e2e.test.js
# Drops the `w.axis === null` guard in wheelDecision() so the axis is recomputed on
# every wheel event instead of locked at gesture start: a later event
# whose dy dominates flips an already-horizontal gesture to vertical and
# stops it from committing.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8935,7 +8935,7 @@ function wheelDecision(w, { deltaX, deltaY, deltaMode, innerHeight }) {
   if (w.skip) return { kind: "skip", axis: w.axis, sx: w.sx, dir: 0 };
   const scale = deltaMode === 1 ? 16 : deltaMode === 2 ? innerHeight : 1;
   const dx = deltaX * scale, dy = deltaY * scale;
-  const axis = w.axis === null && (dx !== 0 || dy !== 0) ? (Math.abs(dx) > Math.abs(dy) ? "x" : "y") : w.axis;
+  const axis = (dx !== 0 || dy !== 0) ? (Math.abs(dx) > Math.abs(dy) ? "x" : "y") : w.axis;
   if (axis !== "x") return { kind: "pass", axis, sx: w.sx, dir: 0 };
   if (w.fired) return { kind: "hold", axis, sx: w.sx, dir: 0 };
   const sx = w.sx + dx;

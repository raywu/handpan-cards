diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8110,7 +8110,7 @@ const escA = s => esc(s).replace(/"/g, "&quot;");
    "Where the ratios come from, and what actually changed".
    Safe above the solver's budget because in the app the field circle itself
    bounds a name; ext comes from f_num on generated decks only. */
-const labelSize = HPE.pdfcards.labelSize;
+const labelSize = (r, zone) => HPE.pdfcards.labelSize(r, zone) / 1.05;
 const NUM_RATIO = 0.64;
 function numSize(rNote) { return rNote * NUM_RATIO; }
 

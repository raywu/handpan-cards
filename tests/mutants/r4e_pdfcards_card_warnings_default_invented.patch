# R4-E: a deck with no warnings is given NO_THIRDS.
diff --git a/src/engine/pdfcards.js b/src/engine/pdfcards.js
--- a/src/engine/pdfcards.js
+++ b/src/engine/pdfcards.js
@@ -431,7 +431,7 @@
   var CARD_WARNINGS = { NO_THIRDS: "NO 3RDS ON THIS PAN" };
 
   function cardWarnings(deck) {

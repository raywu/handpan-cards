 /* ---------------- state ---------------- */
 // Two storage keys, deliberately separate. "hpfc" is the small settings object
 // (which deck, which mode) and is SHARED with whatever a later feature adds to
 // it, so save() reads-modifies-writes rather than replacing it. Saved scales
 // are a list, own their own key, and hold the SEED - the canonical scale string
 // plus its options - never the built deck, which is derived (D14).
 const STORE_KEY = "hpfc";
 const DEFAULT_DECK = "kurd";
 const SCALES_KEY = "hpfc.scales.v3";
 const LEGACY_SCALES_KEY = "hpfc.scales";
 const readStore = key => { try { return JSON.parse(localStorage.getItem(key) || "null"); } catch (e) { return null; } };
 let store = readStore(STORE_KEY) || {};
 if (typeof store !== "object" || Array.isArray(store)) store = {};
 // Only unrelated preferences use hpfc now. Invalid source bytes are recovery
 // evidence: neither a language choice nor practice settings may replace them.
 function updateSettings(change) {
   try {
     const raw = localStorage.getItem(STORE_KEY);
     const guarded = savedPreference(raw);
     if (!guarded.ok) return false;
     const base = guarded.value;
     const next = { ...base };
     change(next);
     const encoded = JSON.stringify(next);
     if (encoded !== JSON.stringify(base)) localStorage.setItem(STORE_KEY, encoded);
     return true;
   } catch (e) { return false; }
 }
 

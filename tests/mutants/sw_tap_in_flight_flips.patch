# kills: a tap during the fly-out lands it once and never flips the wrong card
# suite: node --test --test-name-pattern ^card.swipe:.a.tap.during.the.fly-out.lands.it.once.and.never.flips.the.wrong.card$ tests/e2e.test.js
# Drops the eatClick assignment from the capture pointerdown: a tap that
# lands directly on #card while a fly-out is in flight no longer marks the
# follow-up click for suppression, so it also flips the card that just
# landed instead of only landing it.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8129,7 +8129,6 @@ card.addEventListener("pointercancel", e => { if (drag && e.pointerId === drag.id) release(e, true); });
 card.addEventListener("lostpointercapture", e => { if (drag && e.pointerId === drag.id) release(e, true); });
 // Capture phase: land a pending fly-out before any other input reaches the app.
 document.addEventListener("pointerdown", e => {
-  eatClick = !!flight && card.contains(e.target);
   land();
 }, true);
 document.addEventListener("keydown", () => { land(); }, true);

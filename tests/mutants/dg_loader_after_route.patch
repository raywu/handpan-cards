 // deck that was selected last session is in the registry by the time deck()
@@ -11454,6 +11453,7 @@ if (location.hash.indexOf(SHARE_PREFIX) === 0)
 bootStored = null;
 syncRoute();
 booted = true;
+loadAnalytics();
 </script>
 </body>
 </html>

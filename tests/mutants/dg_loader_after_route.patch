+++ b/index.html
@@ -11418,7 +11418,6 @@ window.addEventListener("hashchange", () => {
 });
 
 /* ---------------- go ---------------- */
-loadAnalytics();
 sheet.setAttribute("hidden", ""); buildSwatches(); paintLayout(); resyncSheet(true);

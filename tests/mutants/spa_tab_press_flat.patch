# suite: node --test --test-name-pattern ^SPA..the.selected.tab.s.pressed.colour.differs.from.its.rest.colour$ tests/e2e.test.js
# The selected tab has no pressed colour.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -1260,7 +1260,6 @@ body:has(#scale-sheet:not([hidden])) #settings-trigger{visibility:hidden}

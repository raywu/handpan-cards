# kills: the hit layer is emitted after everything it sits over
# suite: node --test --test-name-pattern ^the.hit.layer.is.emitted.after.everything.it.sits.over$ tests/app.test.js
# Emits the hit layer immediately after the <svg> open tag instead of last. SVG
# paints in document order with no z-index, so every target ends up under an
# opaque white field circle and no tap on a note ever reaches it.
# Refreshed 2026-10-08 (DR2a): re-anchored on the DR2a source
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8203,8 +8203,8 @@ function pan(d, ch, opts) {
   // one of the picked ring's, the picked ring wins the tap.
   if (interactive) {
     const byOrder = (a2, b2) => a2.at - b2.at;
-    s += veils.join("") + seatMarks.join("") + armMarks.join("") + pickMarks.join("") + flashMarks.join("")
-      + `<g class="panhits">${hits.sort(byOrder).concat(sameHits.sort(byOrder)).map((h) => h.node).join("")}</g>`;
+    s = s.replace(/(<svg[^>]*>)/, (m0) => m0 + `<g class="panhits">${hits.sort(byOrder).concat(sameHits.sort(byOrder)).map((h) => h.node).join("")}</g>`);
+    s += veils.join("") + seatMarks.join("") + armMarks.join("") + pickMarks.join("") + flashMarks.join("");
   }
   return s + "</svg>";
 }

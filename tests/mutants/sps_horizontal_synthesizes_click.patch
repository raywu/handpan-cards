diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -11720,6 +11720,7 @@ function setTab(tab) {
       const changed = e.changedTouches;
       const p = changed && changed.length === 1 && changed[0].identifier === S.id && changed[0];
       if (!p || (e.touches && e.touches.length) || !point(p)) { cancel(); return; }
+      if (e.target && e.target.click) e.target.click();
       const elapsed = Date.now() - S.at, dx = p.clientX - S.x, dy = p.clientY - S.y;

# kills: a hit target reaches 44px, never undercuts its own note, and never laps a neighbour
# suite: node --test --test-name-pattern ^a.hit.target.reaches.44px..never.undercuts.its.own.note..and.never.laps.a.neighbour$ tests/app.test.js
# panHitRadii's rule is "never smaller than the drawn note, never bigger than
# half the gap to the nearest neighbour" (index.html comment above the
# function). Dropping the `p[2] || 0` term removes the note-radius floor, so
# a note drawn bigger than the 44px touch-target floor (a sparse pan) gets
# clamped DOWN to 44px instead of keeping its own larger, already-visible
# radius - a user aiming at a circle they can plainly see could miss it.
diff --git a/index.html b/index.html
index 3e34a0f..e5da572 100644
--- a/index.html
+++ b/index.html
@@ -6476,7 +6476,7 @@ function panHitRadii(ext, sizePx, minPx, pts) {
     for (let j = 0; j < pts.length; j += 1)
       if (j !== i)
         half = Math.min(half, Math.hypot(p[0] - pts[j][0], p[1] - pts[j][1]) / 2);
-    return Math.min(Math.max((minPx / 2) * scale, p[2] || 0), half);
+    return Math.min((minPx / 2) * scale, half);
   });
 }
 

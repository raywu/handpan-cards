# kills: move: a non-ASCII-named record moves by the normal path and shows its chip on the new host
# suite: node --test --test-name-pattern ^move..a.non.ASCII.named.record.moves.by.the.normal.path tests/e2e.test.js
# why: the move URL leaves every row whose name is not ASCII out of the payload, so those scales never reach the new host.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -17406,7 +17406,7 @@
   const rows = savedState.entries.map(row => {
     const read = readSavedRecord(row.record);
     return { i: row.instanceId, r: read.ok ? read.record : row.record };
-  });
+  }).filter(x => !/[^\x00-\x7f]/.test(JSON.stringify(x.r)));
   const hidden = savedState.hidden.slice();
   if (!rows.length && !hidden.length) return plain;
   const encodeRows = n => moveEncode(JSON.stringify({ r: rows.slice(0, n), h: hidden }));

# kills: the menu's NAME->NOTES and NOTES->NAME buttons split their row evenly
# suite: node --test --test-name-pattern ^the.menu.s.NAME..NOTES.and.NOTES..NAME.buttons.split.their.row.evenly$ tests/e2e.test.js
# Lane S2, audit fix A5. Drops .modebar .mode{flex:1 1 0}, leaving NAME->NOTES
# and NOTES->NAME sized by their own text again - a ragged pair instead of
# an equal-width row.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -251,7 +251,6 @@ a.mode{text-decoration:none}
 .mode.on{background:#f1ece1; color:#272219; border-color:#f1ece1}
 /* A5 (audit): NAME->NOTES and NOTES->NAME were sized by their own text, so a
    ragged pair sat side by side. */
-.modebar .mode{flex:1 1 0}
 #settings-trigger[aria-expanded="true"]{background:#f1ece1; color:#272219; border-color:#f1ece1}
 .sr-only{position:absolute; width:1px; height:1px; margin:-1px; padding:0; border:0;
   overflow:hidden; white-space:nowrap; clip:rect(0 0 0 0)}

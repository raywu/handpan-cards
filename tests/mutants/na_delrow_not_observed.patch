# kills: SPC: at 844x390 R4: on Edit a delete row that grows while the footer is shut resizes the pan within one frame, with the restore then changing nothing
# suite: node --test --test-name-pattern ^SPC:.at.844x390.R4: tests/e2e.test.js
# The band watcher stops observing the delete row, so a taller one leaves the pan at the old size until the restore.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -10614,7 +10614,7 @@
   bandWatch.observe(plateBand);
   bandWatch.observe(bandPort);
   bandWatch.observe(drawerStatus);
-  for (const el of [nextBtn, genBtn, delRow, document.getElementById("scale-foot")]) if (el) bandWatch.observe(el);
+  for (const el of [nextBtn, genBtn, document.getElementById("scale-foot")]) if (el) bandWatch.observe(el);
 }
 /** A native focus scrolls a text control only far enough to show its caret;
  *  rule G-c wants the whole control in the scrollport. */

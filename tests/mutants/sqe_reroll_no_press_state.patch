# kills: the re-roll control reads as a button in mode S and reverts outside it
# suite: node --test --test-name-pattern ^the.re-roll.control.reads.as.a.button.in.mode.S.and.reverts.outside.it$ tests/app.test.js
# Drops .shuffle.reroll:active, so pressing "New progression" only recolours
# its text while the arrow buttons beside it darken their fill: the framed
# re-roll button feels flatter than its neighbours (#163 reviewer nit 2).
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -1095,7 +1095,6 @@ body:has(#scale-sheet:not([hidden])) #settings-trigger{visibility:hidden}
 .mode:active{background:#2e281e}
 .mode.on:active{background:#ddd9cf; border-color:#ddd9cf}
 .shuffle:active{color:#f6f4ed}
-.shuffle.reroll:active{background:#2e281e}
 .card:active{box-shadow:0 0 0 3px rgba(234,230,223,.22)}
 

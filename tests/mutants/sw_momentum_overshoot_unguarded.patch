# kills: swipe core: outTiming: a card dragged past dist still flies forward
# suite: node --test --test-name-pattern ^outTiming..a.card.dragged.past.dist.still.flies.forward$ tests/swipe.test.js
# swipeOutTiming: a card dragged past dist still flies forward
# Drops the Math.max(dist, ...) guard and uses dist directly as the flight's
# end point (docs/plans/2026-10-01-swipe-momentum.md, decision 2). When a
# drag has already carried the card past dist (|dx| > dist), the remaining
# span end - |dx| goes negative - a card dragged to -900px against a 654px
# dist would be asked to fly BACKWARD to finish the gesture, instead of the
# guard keeping the flight moving forward.
# Re-anchored to src/engine/swipe.js (App UX P1); the unit case in tests/swipe.test.js kills it.
diff --git a/src/engine/swipe.js b/src/engine/swipe.js
--- a/src/engine/swipe.js
+++ b/src/engine/swipe.js
@@ -15,7 +15,7 @@ HPE.swipe = (function () {
   }
   function swipeOutTiming(vx, dir, dx, dist) {
     const v = Math.max(-dir * vx, SWIPE_MOMENTUM_FLOOR_PX_MS);
-    const end = Math.max(dist, Math.abs(dx) + SWIPE_MOMENTUM_FLOOR_PX_MS * SWIPE_MOMENTUM_MIN_MS);
+    const end = dist;
     const d = end - Math.abs(dx);
     const duration = Math.min(SWIPE_MOMENTUM_MAX_MS, Math.max(SWIPE_MOMENTUM_MIN_MS, d / v));
     const k = v * duration / d;

# kills: DR3 Escape from the disclosure closes the drawer and focuses the toggle
# suite: node --test --test-name-pattern ^DR3.Escape.from.the.disclosure.closes.the.drawer.and.focuses.the.toggle$ tests/app.test.js
# Escape pressed on the finer-controls disclosure does nothing, so Adjust layout stays open.
# Re-anchored 2026-10-19 (lane P): DRAWER_ZONE is gone; the Escape handler is the seam.
# The disclosure toggle is outside the drawer zone, so closing the drawer from it leaves focus on a hidden control.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -12633,7 +12633,7 @@ document.addEventListener("keydown", e => {
     if (e.key === "Escape") {
       e.preventDefault();
       if (drawerOpen && pickRef) putDownPick();
-      else if (drawerOpen) closeAdjust();
+      else if (drawerOpen && document.activeElement !== fineBtn) closeAdjust();
       else closeScaleSheet();
     }
     return;

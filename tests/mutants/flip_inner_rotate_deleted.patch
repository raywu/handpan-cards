# The checked card no longer rotates its .inner, so the answer face never shows; the checkbox still toggles.
diff --git a/scales/d-kurd-10/index.html b/scales/d-kurd-10/index.html
--- a/scales/d-kurd-10/index.html
+++ b/scales/d-kurd-10/index.html

# kills: SB-5 Tab in the ADD sheet skips a control inside a hidden row
# suite: node --test --test-name-pattern ^SB-5.Tab.in.the.ADD.sheet.skips.a.control.inside.a.hidden.row$ tests/app.test.js
# isStop stops asking the browser whether the control is rendered, so Tab lands inside a hidden row.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -15525,7 +15525,7 @@ const HOLD_MS = 250, HOLD_SLOP = 8, MOUSE_SLOP = 4, GHOST_LIFT = 36, GHOST_RETUR
 // A stop is a control the page renders and the user can operate. Rendering is
 // asked of the browser (a control inside a hidden ancestor, or unrendered by
 // CSS, has no client rects), never of a hand-kept mode table.
-const isStop = el => !!el && !el.disabled && el.getClientRects().length > 0;
+const isStop = el => !!el && !el.disabled;
 function cycleTabStops(all, e) {
   const stops = typeof getComputedStyle === "function" ? all.filter(el => getComputedStyle(el).visibility !== "hidden") : all;
   if (!stops.length) return;

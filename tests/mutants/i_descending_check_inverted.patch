# kills: source order flags: out-of-order and repeated pitches are confirmations, not refusals
# suite: node --test --test-name-pattern ^source.order.flags..out.of.order.and.repeated.pitches.are.confirmations..not.refusals$ tests/import.test.js
# SOURCE_NOT_ASCENDING fires on rises instead of falls, so the Harmonic Minor
# line loses its out-of-order notes and an ascending line is accused.
diff --git a/src/engine/importer.js b/src/engine/importer.js
--- a/src/engine/importer.js
+++ b/src/engine/importer.js
@@ -270,7 +270,7 @@
       var prev = null;
       list.notes.forEach(function (n) {
         if (n.assigned === "unknown" || n.midi === null) return;
-        if (prev && n.midi < prev.midi) descending.push(prev.index, n.index);
+        if (prev && n.midi > prev.midi) descending.push(prev.index, n.index);
         prev = n;
       });
     });

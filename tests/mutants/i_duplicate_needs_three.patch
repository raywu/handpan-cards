# kills: source order flags: out-of-order and repeated pitches are confirmations, not refusals
# suite: node --test --test-name-pattern ^source.order.flags..out.of.order.and.repeated.pitches.are.confirmations..not.refusals$ tests/import.test.js
# DUPLICATE_PITCH needs three copies of a pitch instead of two, so the
# repeated B3 in the Harmonic Minor line goes unreported.
diff --git a/src/engine/importer.js b/src/engine/importer.js
--- a/src/engine/importer.js
+++ b/src/engine/importer.js
@@ -528,7 +528,7 @@
       var g = byPitch[k];
       if (g.t.length > 1) sameShell = sameShell.concat(g.t);
       if (g.b.length > 1) sameShell = sameShell.concat(g.b);
-      if (g.t.length && g.b.length) repeated = repeated.concat(g.t, g.b);
+      if (g.t.length + g.b.length > 2 && g.t.length && g.b.length) repeated = repeated.concat(g.t, g.b);
     });
     var num = function (a, b) { return a - b; };
     if (sameShell.length && !flags.CONFLICTING_DING) flag("REPEATED_IN_SHELL", { notes: sameShell.sort(num) });

# kills: the browser's Back button closes the page and pops nothing further
# suite: node --test --test-name-pattern ^the.browser.s.Back.button.closes.the.page.and.pops.nothing.further$ tests/app.test.js
# popstate routes through the app's own close, which pops AGAIN. The entry the
# gesture already consumed is gone, so the second pop leaves the site.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -10117,8 +10117,7 @@ let pendingPop = false;
 window.addEventListener("popstate", () => {
   if (pendingPop) { pendingPop = false; syncRoute(); return; }
   if (!sheetOpen) return;
-  sheetRouted = false;
-  hideSheet();
+  closeScaleSheet();
 });
 

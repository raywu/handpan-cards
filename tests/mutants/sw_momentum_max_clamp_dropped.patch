# kills: swipeOutTiming: a slow or zero-velocity release starts at the floor and clamps at SWIPE_MOMENTUM_MAX_MS
# swipeOutTiming: a slow or zero-velocity release starts at the floor and clamps at SWIPE_MOMENTUM_MAX_MS
# suite: node --test --test-name-pattern ^swipeOutTiming:.a.slow.or.zero-velocity.release.starts.at.the.floor.and.clamps.at.SWIPE_MOMENTUM_MAX_MS$ tests/app.test.js
# Drops the Math.min(SWIPE_MOMENTUM_MAX_MS, ...) clamp from swipeOutTiming's
# duration calculation (docs/plans/2026-10-01-swipe-momentum.md, decision 2).
# A slow or zero-velocity release (speed floored at SWIPE_MOMENTUM_FLOOR_PX_MS)
# then takes however long d/v actually is - 400ms for the test's fixture,
# not the clamped 320ms - so the card crawls off-screen well past the
# intended cap.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8178,7 +8178,7 @@ function swipeOutTiming(vx, dir, dx, dist) {
   const v = Math.max(-dir * vx, SWIPE_MOMENTUM_FLOOR_PX_MS);
   const end = Math.max(dist, Math.abs(dx) + SWIPE_MOMENTUM_FLOOR_PX_MS * SWIPE_MOMENTUM_MIN_MS);
   const d = end - Math.abs(dx);
-  const duration = Math.min(SWIPE_MOMENTUM_MAX_MS, Math.max(SWIPE_MOMENTUM_MIN_MS, d / v));
+  const duration = Math.max(SWIPE_MOMENTUM_MIN_MS, d / v);
   const k = v * duration / d;
   const x1 = Math.min(1 / 3, 1 / k);
   const y1 = k * x1;

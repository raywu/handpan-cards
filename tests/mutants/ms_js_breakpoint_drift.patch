 // reached by a click and the modal state above is never applied; the panel is
 // simply always visible as a static sidebar (CSS only).
-const desktopMQ = window.matchMedia("(min-width:1024px) and (min-height:700px)");
+const desktopMQ = window.matchMedia("(min-width:1100px) and (min-height:700px)");

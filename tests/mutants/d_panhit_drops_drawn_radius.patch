# kills: every hit target is centred on the field circle it selects
# suite: node --test --test-name-pattern ^every.hit.target.is.centred.on.the.field.circle.it.selects$ tests/app.test.js
# Drops data-r from the emitted target. The sizer then has no drawn radius to
# floor at, so on a sparse pan every target silently shrinks from the note ring
# the user is aiming at (53.8px on Hijaz) down to the bare 44px minimum.
# Refreshed 2026-10-08 (DR2a): re-anchored on the DR2a source
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8191,7 +8191,7 @@ function pan(d, ch, opts) {
         flashMarks.push(`<circle class="panflash" ${at} r="${rr * 1.12}" fill="none" stroke="#E27005"`
           + ` stroke-width="3" vector-effect="non-scaling-stroke" pointer-events="none"/>`);
       const node = `<circle class="panhit" data-field="${id}" data-ring="${m.ring}" ${at} r="${rr}"`
-        + ` data-r="${rr}" fill="transparent" tabindex="${String(hit.rover) === String(id) ? 0 : -1}"`
+        + ` fill="transparent" tabindex="${String(hit.rover) === String(id) ? 0 : -1}"`
         + ` role="button" aria-pressed="${String(id) === picked}" aria-label="${escA(m.label)}"/>`
         + `<circle class="panfocus" ${at} r="${rr * 1.32}" fill="none" stroke="#272219"`
         + ` stroke-width="2" vector-effect="non-scaling-stroke" pointer-events="none"/>`;

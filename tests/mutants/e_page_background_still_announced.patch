# kills: the background behind the page is hidden from assistive tech, not only from the pointer
# suite: node --test --test-name-pattern ^the.background.behind.the.page.is.hidden.from.assistive.tech..not.only.from.the.pointer$ tests/e2e.test.js
# inert is set but aria-hidden is not. The background stops taking taps and tab
# stops, so every pointer and keyboard test still passes, while a screen reader
# reads straight through the open page into the practice screen behind it.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -14691,7 +14691,7 @@ function showSheet(opener) {
   pageOpenerSelection=[...document.getElementById("decks").children].includes(pageOpener)?{kind:pageOpener.getAttribute("data-selection-kind"),id:pageOpener.getAttribute("data-selection-id")}:null;
   sheet.removeAttribute("hidden");
   pageOpen = true;
-  setInert(true, background);
+  for (const el of background) { el.inert = true; }
   if (reuseEntry) history.replaceState({ scalePage: true }, "", sheetRoute());
   else history.pushState({ scalePage: true }, "", sheetRoute());
   reuseEntry = false;

# kills: LS 844x390: at rest on Scale the name field, both tabs and the first tray chip are fully in view and hit at their centres, and the column is one scroll box at its top
# suite: node --test --test-name-pattern ^LS.844x390..at.rest tests/editor_e2e.test.js
# fault: In phone landscape the column snaps to its end (the toolbar is a mandatory end snap point), so it opens scrolled down and the name field and tabs are out of view at rest.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -1085,6 +1085,7 @@ body:has(#scale-sheet:not([hidden])) #settings-trigger{visibility:hidden}
     grid-template-columns:minmax(0,1fr) minmax(300px,1fr); grid-template-rows:repeat(6, max-content) minmax(0,1fr);
     grid-template-areas:"head head" "pan line" "pan status" "pan counts" "pan region" "pan bar" "pan ."}
   #scale-sheet.onepanel #editor::-webkit-scrollbar{display:none}
+  #scale-sheet.onepanel #editor{scroll-snap-type:y mandatory} #editor .editor-toolbar{scroll-snap-align:end}
   #scale-sheet.onepanel #editor.dragging, #scale-sheet.onepanel #editor:has(#editor-dialog:not([hidden])){overflow:hidden}
   #editor .editor-head{grid-area:head} #editor .editor-line{grid-area:line} #editor .editor-statusrow{grid-area:status}
   #editor-status{min-height:28px} #editor-counts{grid-area:counts}

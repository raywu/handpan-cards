# kills: releaseDecision: a cancelled drag eats no click
# suite: node --test --test-name-pattern ^releaseDecision..a.cancelled.drag.eats.no.click$ tests/swipe.test.js
# Drops the `!cancelled` guard, so a cancelled release (pointercancel/
# lostpointercapture) arms eatClick same as a normal commit, decay and all
# (the decay branch at index.html:8159-8164 is untouched, so eatClick still
# clears itself after the usual 400ms/0ms window - it is not stuck). The
# failure is that a click landing inside that window right after a
# cancelled drag is wrongly eaten instead of flipping, since a cancel
# should never arm eatClick at all (it has no trailing click of its own to
# consume).
# Context-refreshed 2026-09-30 (desktop-swipe lane): hunk context updated for release()/lpc/wheel refactor (setEatClick, flyOut/springBack, pushPoint); the mutation itself is unchanged.
# Re-cut 2026-10-03 (AP1-a): release() now executes releaseDecision() and both pointerdown sites call canStartGesture(); the mutation is re-expressed on the new site, intent unchanged.
# Re-anchored to src/engine/swipe.js (App UX P1); the unit case in tests/swipe.test.js kills it.
diff --git a/src/engine/swipe.js b/src/engine/swipe.js
--- a/src/engine/swipe.js
+++ b/src/engine/swipe.js
@@ -31,7 +31,7 @@ HPE.swipe = (function () {
   function releaseDecision({ dx, dy, vx, moved, cancelled, blocked, reducedMotion }) {
     const dir = blocked ? 0 : swipeDecision(dx, dy, vx);
     if (!dir && !moved) return { kind: "rest", dir: 0, eatClick: false };
-    const eatClick = moved && !cancelled;
+    const eatClick = moved;
     if (reducedMotion) return { kind: "rest", dir, eatClick };
     return { kind: dir ? "fly" : "spring", dir, eatClick };
   }

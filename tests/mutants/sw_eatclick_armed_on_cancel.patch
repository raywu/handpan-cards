# kills: card swipe: a click right after a cancelled drag is not eaten
# suite: node --test --test-name-pattern ^card.swipe:.a.click.right.after.a.cancelled.drag.is.not.eaten$ tests/e2e.test.js
# Drops the `!cancelled` guard, so a cancelled release (pointercancel/
# lostpointercapture) arms eatClick same as a normal commit. No click ever
# follows a cancel, so eatClick is left stuck true with nothing to clear it,
# eating the next unrelated click - e.g. Enter's native click on a focused
# button.
# Context-refreshed 2026-09-30 (desktop-swipe lane): hunk context updated for release()/lpc/wheel refactor (setEatClick, flyOut/springBack, pushPoint); the mutation itself is unchanged.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8170,7 +8170,7 @@ function release(e, cancelled, pushPoint = true) {
   // 0) ahead of pointerup/click on a real mouse release, so the trailing
   // click can arrive a tick or more after this runs - touch/pen keep the
   // immediate decay, since their synthesized click (if any) follows at once.
-  if (moved && !cancelled) setEatClick(true, pointerType === "mouse" ? 400 : 0);
+  if (moved) setEatClick(true, pointerType === "mouse" ? 400 : 0);

# kills: SO: en 844x390: every landscape message is fully readable inside the tab strip and moves nothing
# suite: node --test --test-name-pattern ^SO:.en.844x390..every.landscape tests/editor_e2e.test.js
# fault: In phone landscape the message box starts 8px above the tab strip, so it covers the bottom of the scale field.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -1091,7 +1091,7 @@ body:has(#scale-sheet:not([hidden])) #settings-trigger{visibility:hidden}
   #editor .editor-statusrow{grid-area:region; align-self:start; height:0; min-height:0; z-index:5}
   #editor-status, #editor .editor-statusrow:has(#editor-status[data-conflict]){min-height:0}
   #editor-status{position:absolute; left:0; right:-8px; top:0; bottom:auto; border-radius:8px; pointer-events:none}
-  #editor-status:not([data-conflict]){max-height:none; align-items:flex-start; padding-block:1px; font-size:12px; line-height:14px}
+  #editor-status:not([data-conflict]){top:-8px; max-height:none; align-items:flex-start; padding-block:1px; font-size:12px; line-height:14px}
   #scale-sheet.onepanel #editor .editor-statusrow:not(:has(#editor-status[data-conflict])){position:sticky; top:0}
   #editor-status[data-idle]{clip-path:inset(50%)}
   #editor-status:not(:empty):not([data-kind="error"]){background:#F6F4ED}

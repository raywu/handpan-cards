# kills: card swipe: a mouse lostpointercapture with a button still held cancels the drag
# suite: node --test --test-name-pattern ^card.swipe..a.mouse.lostpointercapture.with.a.button.still.held.cancels.the.drag$ tests/e2e.test.js
# Drops the `!(e.buttons & 1)` check: a mouse lostpointercapture is
# always treated as Chrome's ordinary release, even when a button is
# still reported held, so it never falls through to the cancel branch.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8219,7 +8219,7 @@ card.addEventListener("pointercancel", e => { if (drag && e.pointerId === drag.i
 // not pushed into drag.pts on this path (see release()'s pushPoint doc).
 card.addEventListener("lostpointercapture", e => {
   if (!drag || e.pointerId !== drag.id) return;
-  if (e.pointerType === "mouse" && !(e.buttons & 1)) release(e, false, false);
+  if (e.pointerType === "mouse") release(e, false, false);
   else release(e, true);
 });

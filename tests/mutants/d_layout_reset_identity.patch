# RESET writes the identity permutation instead of clearing the correction,
# so a reset deck carries a correction on the wire that says nothing.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -4384,7 +4384,8 @@ function stepLayoutSel(by) {
   previewLayout();
 }
 function resetLayout() {
-  layoutOrder = null;
+  const reset = layoutFields();
+  layoutOrder = identityOrder(reset ? syncLayoutOrder(reset) : 0);
   layoutSel = 0;
   previewLayout();
 }

 function scaleRecord(seed) {
-  return { v: HPE.share.recordVersion(seed), s: HPE.core.formatSeed(seed.fields), o: seed.options };
+  return { v: HPE.share.recordVersion(seed), s: HPE.core.formatSeed(seed.fields), o: {} };
 }

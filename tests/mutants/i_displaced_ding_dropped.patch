# kills: a picked ding on a note after the first moves to the front: same string as the labelled form
# suite: node --test --test-name-pattern ^a.picked.ding.on.a.note.after.the.first.moves.to.the.front..same.string.as.the.labelled.form$ tests/import.test.js
# A ding label on a note that is not the picked ding no longer demotes that note to a top note, so the displaced ding silently vanishes from the string.
diff --git a/src/engine/importer.js b/src/engine/importer.js
--- a/src/engine/importer.js
+++ b/src/engine/importer.js
@@ -469,7 +469,7 @@
       else if (pickable && contested && n.role === "ding" && !n.paren && clauses[n.list].length === 1) n.assigned = "dropped";
       else if (n.paren && parensBottom) { n.assigned = "bottom"; n.inline = true; }
       else if (n.paren) n.assigned = "unknown";
-      else n.assigned = n.role === "ding" ? "top" : n.role;
+      else n.assigned = n.role;
     });
     var dropped = notes.filter(function (n) { return n.assigned === "dropped"; });
     if (dropped.length) flag("DING_CUE_DROPPED", { notes: indices(dropped), ding: ding.index });

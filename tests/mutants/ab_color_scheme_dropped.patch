 <style>
 :root{
-  color-scheme:dark;
   --ink:#242424; --sep:#8a8a8a; --paper:#ffffff;
   --table:#1a1815; --table2:#26221c;
   --root:#0B7B75; --tone:#DD8F00; --ga:#0B7B75; --gb:#DD8F00;

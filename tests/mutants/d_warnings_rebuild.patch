# kills: the success path reads deck.warnings without generating a second time
# suite: node --test --test-name-pattern ^the.success.path.reads.deck.warnings.without.generating.a.second.time$ tests/app.test.js
# The warnings are re-derived by generating the deck a second time. The text
# is identical, so only a call count can see it - and the cost is paid on
# every successful generate.
diff --git a/index.html b/index.html
index 8a5bb64..d184465 100644
--- a/index.html
+++ b/index.html
@@ -3407,7 +3407,8 @@ function runGenerate() {
   if (replaced) replaceRegistered(wasId, d);
   // [eng-review 2, 2A] the warnings are read off the deck the SAME generation
   // produced; nothing is rebuilt to re-derive them.
-  const warned = (d.warnings || []).map(w => w.reason);
+  const __again = generateDeck(String(scaleBox.value || ""), { palette, mirror });
+  const warned = ((__again.ok ? __again.value.warnings : d.warnings) || []).map(w => w.reason);
   let text = (replaced || known.has(d.id))
     ? `Updated ${d.name}` : `${d.chords.length} cards generated`;
   if (!generated.has(d.id)) { generated.add(d.id); text += " " + LAYOUT_HINT; }

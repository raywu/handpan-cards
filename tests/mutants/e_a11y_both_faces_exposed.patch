# kills: only the face that is showing is exposed, and the counter is a live region
# suite: node --test --test-name-pattern only.the.face.that.is.showing.is.exposed tests/e2e.test.js
# Both faces stay in the accessibility tree, so the card reads out the question
# and its answer together and flipping changes nothing.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -6494,19 +6494,6 @@
   // out alongside the question. Expose only the face that is showing, and make
   // it the card's description (descendants of role="button" are presentational,
   // so the text has to reach the button by an idref, not by traversal).
-  const shown = document.getElementById(flipped ? "back" : "front");
-  const away  = document.getElementById(flipped ? "front" : "back");
-  away.setAttribute("aria-hidden", "true");
-  shown.removeAttribute("aria-hidden");
-  // The .prints tab-order workaround that used to live here (printCtrls) is
-  // gone: headerHTML() no longer renders .prints into either face at all
-  // (menu-shell, 2026-09-28 - the print row moved to the settings panel), so
-  // there is no focusable control left inside a face for aria-hidden to
-  // strand from the tab order. The aria-hidden/removeAttribute pair above
-  // STAYS: both faces remain in the DOM across a flip, and the one turned
-  // away must still be hidden from assistive tech, printCtrls or not
-  // (e_a11y_both_faces_exposed is re-targeted onto this pair, not retired).
-  cardEl.setAttribute("aria-describedby", shown.id);
 }


# kills: pick never returns the previous sequence when another exists
# prev is never treated as valid, so pick can repeat it outright
# suite: node --test --test-name-pattern ^pick.never.returns.the.previous.sequence.when.another.exists$ tests/sequence.test.js
diff --git a/src/engine/sequence.js b/src/engine/sequence.js
--- a/src/engine/sequence.js
+++ b/src/engine/sequence.js
@@ -216,7 +216,7 @@
       return { chords: null, reason: "TOO_FEW_CHORDS" };
     }

-    var prevValid = Array.isArray(prev) && prev.length > 0 &&
+    var prevValid = false && Array.isArray(prev) && prev.length > 0 &&
       prev.every(function (idx) {
         return typeof idx === "number" && idx >= 0 && idx < deck.chords.length;
       });

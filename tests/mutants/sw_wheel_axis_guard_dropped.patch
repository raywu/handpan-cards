# kills: card swipe (wheel): a vertical-dominant wheel does nothing and is not preventDefault-ed
# suite: node --test --test-name-pattern ^card.swipe..wheel...a.vertical-dominant.wheel.does.nothing.and.is.not.preventDefault-ed$ tests/e2e.test.js
# Drops the `if (axis !== "x") return { kind: "pass", ... }` line in
# wheelDecision(): a vertical-dominant wheel gesture is no longer passed
# through, so it is preventDefault-ed and processed as a swipe too.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8936,7 +8936,6 @@ function wheelDecision(w, { deltaX, deltaY, deltaMode, innerHeight }) {
   const scale = deltaMode === 1 ? 16 : deltaMode === 2 ? innerHeight : 1;
   const dx = deltaX * scale, dy = deltaY * scale;
   const axis = w.axis === null && (dx !== 0 || dy !== 0) ? (Math.abs(dx) > Math.abs(dy) ? "x" : "y") : w.axis;
-  if (axis !== "x") return { kind: "pass", axis, sx: w.sx, dir: 0 };
   if (w.fired) return { kind: "hold", axis, sx: w.sx, dir: 0 };
   const sx = w.sx + dx;
   // sx > 0 means the fingers moved right-to-left (positive deltaX) -> next

# kills: pull then push sends 0 rows
# suite: node --test --test-name-pattern pull.then.push.sends.0.rows tests/sync.test.js
# settlePull records a stale revision, so the next push re-uploads every pulled row.
diff --git a/src/engine/sync.js b/src/engine/sync.js
--- a/src/engine/sync.js
+++ b/src/engine/sync.js
@@ -217,7 +217,7 @@
       let localRevision;
       if (u.mode === "committed") {
         if (!rev.has(u.localId)) throw new Error("sync: no committed revision for " + u.localId);
-        localRevision = rev.get(u.localId);
+        localRevision = rev.get(u.localId) - 1;
       } else if (u.mode === "edited") localRevision = null;
       else localRevision = before ? before.localRevision : null;
       next.base[u.rid] = { rev: u.rev, localRevision };

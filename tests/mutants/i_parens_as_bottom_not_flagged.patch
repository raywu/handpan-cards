# kills: L1 (b): parens bottom clears UNDECLARED_PARENS and raises PARENS_AS_BOTTOM wherever it changes a reading
# suite: node --test --test-name-pattern ^L1..b...parens.bottom.clears tests/import_gold.test.js
# Reading round brackets as bottoms raises no PARENS_AS_BOTTOM confirmation, so the reader is never told.
diff --git a/src/engine/importer.js b/src/engine/importer.js
--- a/src/engine/importer.js
+++ b/src/engine/importer.js
@@ -475,7 +475,7 @@
     if (dropped.length) flag("DING_CUE_DROPPED", { notes: indices(dropped), ding: ding.index });
     if (pickable && ding.role === "bottom") flag("DING_ON_BOTTOM", { ding: ding.index });
     var inlined = notes.filter(function (n) { return n.inline; });
-    if (inlined.length) flag("PARENS_AS_BOTTOM", { notes: indices(inlined) });
+    if (false) flag("PARENS_AS_BOTTOM", { notes: indices(inlined) });
     var unknown = notes.filter(function (n) { return n.assigned === "unknown"; });
     if (unknown.length) flag("UNDECLARED_PARENS", { notes: indices(unknown) });
     if (!ding && !flags.CONFLICTING_DING && !unknown.length) return insufficient();

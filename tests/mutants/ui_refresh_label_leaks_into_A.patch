# kills: in mode S the re-roll control is an icon named "New progression", and leaving S restores Shuffle
# suite: node --test --test-name-pattern ^in.mode.S.the.re-roll.control.is.an.icon.named..New.progression...and.leaving.S.restores.Shuffle$ tests/app.test.js
# Lane S2, acceptance 5/U4. Drops removeAttribute("aria-label") on leaving S,
# so Shuffle keeps announcing "New progression" in modes A/B.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -7961,7 +7961,6 @@ function setMode(m) {
     shuffleBtn.classList.add("reroll");
   } else {
     shuffleBtn.textContent = "Shuffle: " + (shuffled ? "on" : "off");
-    shuffleBtn.removeAttribute("aria-label");
     shuffleBtn.classList.toggle("on", shuffled);
     shuffleBtn.classList.remove("reroll");
   }

# kills: tabbing away from DELETE disarms it too
# suite: node --test --test-name-pattern ^tabbing.away.from.DELETE.disarms.it.too$ tests/app.test.js
# The blur wiring goes away. A desktop owner who tabs off an armed DELETE
# comes back to a button that still deletes on one tap.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -13658,7 +13658,6 @@ delBtn.onclick = () => {
 sheet.addEventListener("pointerdown", (e) => {
   if (e.target !== delBtn) disarmDelete();
 });  // disarmDelete() is a no-op unless armed, so an ordinary tap writes nothing.
-delBtn.onblur = disarmDelete;

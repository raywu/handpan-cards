# kills: QA1 every editor input with placeholder text paints it lighter than typed text, in main's drawer placeholder grey (#8A847B)
# suite: node --test --test-name-pattern QA1.every.editor.input tests/editor_e2e.test.js
# The name placeholder goes back to the darker #6B665E, so the suggestion reads like typed text.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -908,7 +908,7 @@ body:has(#scale-sheet:not([hidden])) #settings-trigger{visibility:hidden}
 #editor-line[aria-invalid="true"]{border-color:#242424; border-width:2px}
 #editor-name{width:calc(100% - 44px - var(--sp-2)); box-sizing:border-box; min-height:44px; padding:9px var(--sp-3); font:500 16px/1.3 "Nunito Sans"; color:#242424;
   background:#fff; border:1px solid #8A847B; border-radius:8px; text-overflow:ellipsis}
-#editor-name::placeholder{color:#8A847B; opacity:1}
+#editor-name::placeholder{color:#6B665E; opacity:1}
 #editor .editor-statusrow{transition:transform 220ms cubic-bezier(.2,.8,.2,1); flex:0 0 auto; display:flex; align-items:center; gap:var(--sp-2); position:relative; z-index:2; box-sizing:border-box}
 #editor-status{flex:1 1 0; min-width:0; min-height:40px; margin:0; font:600 13px/20px "Nunito Sans"; display:flex; align-items:center; gap:var(--sp-2); position:relative; box-sizing:border-box}
 @media (max-width:420px){#editor-status{min-height:48px}}

# kills: selecting a deck persists its id, custom decks included
# selectDeck reinstates the Phase 3 built-ins-only guard, so a custom deck the
# user selected is not restored on the next boot.
diff --git a/index.html b/index.html
index b018e51..ed3cd2d 100644
--- a/index.html
+++ b/index.html
@@ -2491,7 +2491,7 @@ function restoreScales() {
 
 function selectDeck(id) {
   deckId = id;
-  storedDeck = id;
+  if (isBuiltIn(id)) storedDeck = id;
   save(); setOrder(); buildChips(); render();
 }
 

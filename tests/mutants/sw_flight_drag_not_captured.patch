# kills: card swipe: a second real swipe from the REST position during flight is not dropped
# suite: node --test --test-name-pattern ^card.swipe:.a.second.real.swipe.from.the.REST.position.during.flight.is.not.dropped$ tests/e2e.test.js
# Drops the setPointerCapture call (the whole try/catch block) when a new drag starts mid-flight from
# outside #card's displaced bounds: without it, subsequent pointermove/up
# events keep hit-testing against whatever element the touch actually lands
# on (not #card), so #card's own pointermove listener never sees them and
# the second real swipe is silently dropped.
# Refreshed 2026-10-01 (lane A, quality-refactor finding 13): startDrag() now
# holds the single setPointerCapture call shared by the ordinary #card
# pointerdown and the mid-flight capture-phase pointerdown (both used to
# inline their own copy); this anchors that shared call site directly. The
# mutation itself is unchanged and is a distinct mutant from
# qa_start_drag_never_arms_drag.patch, which drops the `drag = {...}`
# assignment above the capture call rather than the capture call.
# Re-cut 2026-10-04 (close-out lane NIT): the capture call is now a try/catch
# that rethrows anything but NotFoundError, so the hunk removes that block.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8925,8 +8925,6 @@ function swipeMove(e) {
 function startDrag(e) {
   scene.getAnimations().forEach(a => a.cancel());
   drag = { id: e.pointerId, x0: e.clientX, y0: e.clientY, last: 0, lastY: 0, moved: false, pts: [{ x: e.clientX, t: e.timeStamp }], pointerType: e.pointerType };
-  // NotFoundError: a synthetic or already-released pointer id has nothing to capture.
-  try { card.setPointerCapture(e.pointerId); } catch (err) { if (err.name !== "NotFoundError") throw err; }
 }
 function canStartGesture(e, state) {
   return !state.drag && e.isPrimary && e.button === 0 && !state.panelOpen && !state.sheetOpen && state.orderLength > 0;

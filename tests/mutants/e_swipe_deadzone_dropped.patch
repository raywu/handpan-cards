# kills: a swipe shorter than the threshold does not navigate
# suite: node --test --test-name-pattern ^a.swipe.shorter.than.the.threshold.does.not.navigate$ tests/e2e.test.js
# The 18px deadzone collapses to any movement at all. The card is both the flip
# target and the swipe target, so every tap whose thumb slides a pixel now flips
# AND navigates, and the card the reader meant to turn over is gone.
# Retargeted 2026-09-30 (lane SW, card-swipe-animation plan): the old
# touchend-based handler was replaced by the pointer-driven drag/fling
# implementation; the same deadzone drop now targets swipeDecision()'s
# SWIPE_COMMIT_PX comparison.
# Context-refreshed 2026-09-30 (S2): swipeDecision gained a dy parameter and
# an axis-dominance guard (touch-action:none fix); the mutated line and its
# line number both moved, the mutation itself is unchanged.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -8154,7 +8154,7 @@ function swipeDecision(dx, dy, vx) {
   // SWIPE_* threshold, is what keeps a vertical drag from ever navigating.
   if (Math.abs(dy) > Math.abs(dx)) return 0;
   const fling = Math.abs(dx) > SWIPE_SLOP_PX && Math.abs(vx) > SWIPE_FLING_PX_MS && vx * dx > 0;
-  return Math.abs(dx) > SWIPE_COMMIT_PX || fling ? (dx < 0 ? 1 : -1) : 0;
+  return Math.abs(dx) > 0 || fling ? (dx < 0 ? 1 : -1) : 0;
 }

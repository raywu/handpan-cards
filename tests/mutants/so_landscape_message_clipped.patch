# kills: SO: de 568x320: every landscape message is fully readable inside the tab strip and moves nothing
# suite: node --test --test-name-pattern ^SO:.de.568x320..every.landscape tests/editor_e2e.test.js
# fault: The landscape text column beside Cancel or Undo shrinks back to under half the box, so a message wraps past the 44px tab strip and is clipped.
diff --git a/index.html b/index.html
--- a/index.html
+++ b/index.html
@@ -1094,7 +1094,7 @@ body:has(#scale-sheet:not([hidden])) #settings-trigger{visibility:hidden}
   #editor-status:not([data-conflict]){max-height:44px; overflow:hidden; padding-block:1px; font-size:12px; line-height:14px}
   #editor-status:not(:empty):not([data-kind="error"]){background:#F6F4ED}
   #editor-status:not([data-conflict]) button{position:absolute; right:0; top:50%; transform:translateY(-50%); padding-inline:6px; pointer-events:auto}
-  #editor-status:not([data-conflict]):has(button){padding-right:96px; min-height:34px}
+  #editor-status:not([data-conflict]):has(button){padding-right:calc(50% + 56px); min-height:34px}
   #editor-status[data-conflict]{position:absolute; right:0; top:0; bottom:auto; flex-wrap:wrap; padding:var(--sp-2) 12px; pointer-events:auto}
   #scale-sheet.onepanel #editor:has(#editor-areas[hidden]){grid-template-areas:"head head" "pan line" "pan region" "pan bar" "pan ."; grid-template-rows:repeat(4, max-content) minmax(0,1fr)}
   #scale-sheet.onepanel #editor:has(#editor-areas[hidden]) :is(#editor-region, .editor-statusrow){margin-top:calc(4px - var(--sp-3))}
